<?xml version="1.0" encoding="UTF-8"?>
<!--
  OLS XML: the line model of OLS CAD (the content of a line file, .ols.json)
  as XML. See ols-line.md in this folder. The namespace keeps its 1 (the
  schema's own identity); a document's `version` attribute is the line file
  version (now 5; older documents are read and converted).

  This Source Code Form is subject to the terms of the Mozilla Public
  License, v. 2.0. If a copy of the MPL was not distributed with this
  file, You can obtain one at https://mozilla.org/MPL/2.0/.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ols="urn:ols-cad:ols-line:1"
           targetNamespace="urn:ols-cad:ols-line:1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      Lengths and coordinates in metres in the line's coordinate system (x
      east, y north, z up), forces in newtons, temperatures in degrees
      Celsius, angles in degrees. Attribute names are the keys of the line
      file; an absent optional attribute is an absent value (or its default).
    </xs:documentation>
  </xs:annotation>

  <!-- Simple types. -->

  <xs:simpleType name="doubleList">
    <xs:list itemType="xs:double"/>
  </xs:simpleType>

  <xs:simpleType name="color">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="calculation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="initial-rs"/>
      <xs:enumeration value="creep-rs"/>
      <xs:enumeration value="load-rs"/>
      <xs:enumeration value="max-sag-rs"/>
      <xs:enumeration value="initial-fe"/>
      <xs:enumeration value="creep-fe"/>
      <xs:enumeration value="load-fe"/>
      <xs:enumeration value="max-sag-fe"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="systemKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ac"/>
      <xs:enumeration value="dc"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="stringingKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="tension"/>
      <xs:enumeration value="sag"/>
      <xs:enumeration value="unstressed_lengths"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Building blocks. -->

  <xs:attributeGroup name="xyz">
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
    <xs:attribute name="z" type="xs:double" use="required"/>
  </xs:attributeGroup>

  <xs:complexType name="point">
    <xs:attributeGroup ref="ols:xyz"/>
  </xs:complexType>

  <xs:complexType name="onRoute">
    <xs:annotation>
      <xs:documentation>A route something is on (by id).</xs:documentation>
    </xs:annotation>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="object">
    <xs:annotation>
      <xs:documentation>The object on a point (one per point): a body or a
        clamp (kind), the library type it was taken from (type), its weight
        (N, the whole bundle's), its shape for the wind and the ice (point,
        sphere: diameter; cylinder: diameter, length, axis along / across /
        vertical; box: along, across, height; areas: wind_area, ice_area),
        drag (default 1), a clamp's length along the wire. A clamp on a
        jumper held up is a support: its `hold` gives the structure's
        strings to a wire point without a set (structure: default the
        `from` end's; wire), or one string from a fixed point (x, y, z,
        length, weight).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="hold" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="structure" type="xs:string"/>
          <xs:attribute name="wire" type="xs:string"/>
          <xs:attribute name="x" type="xs:double"/>
          <xs:attribute name="y" type="xs:double"/>
          <xs:attribute name="z" type="xs:double"/>
          <xs:attribute name="length" type="xs:double"/>
          <xs:attribute name="weight" type="xs:double" default="0"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="kind" default="body">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="body"/>
          <xs:enumeration value="clamp"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" type="xs:string"/>
    <xs:attribute name="weight" type="xs:double" default="0"/>
    <xs:attribute name="shape" default="point">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="point"/>
          <xs:enumeration value="sphere"/>
          <xs:enumeration value="cylinder"/>
          <xs:enumeration value="box"/>
          <xs:enumeration value="areas"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="diameter" type="xs:double"/>
    <xs:attribute name="length" type="xs:double"/>
    <xs:attribute name="axis">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="along"/>
          <xs:enumeration value="across"/>
          <xs:enumeration value="vertical"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="along" type="xs:double"/>
    <xs:attribute name="across" type="xs:double"/>
    <xs:attribute name="height" type="xs:double"/>
    <xs:attribute name="wind_area" type="xs:double"/>
    <xs:attribute name="ice_area" type="xs:double"/>
    <xs:attribute name="drag" type="xs:double"/>
    <xs:attribute name="clamp_length" type="xs:double"/>
  </xs:complexType>

  <xs:complexType name="field">
    <xs:annotation>
      <xs:documentation>The value of a table column added by a plugin, by
        key "plugin.column" (e.g. a design code's insulation level): kept
        with the object, used by the plugin, shown (unused) where it is not
        installed.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="key" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="alignment">
    <xs:annotation>
      <xs:documentation>An alignment: the route it belongs to and its
        points in order, each by the id of an alignment_point (ref); none
        while it is being laid out. A point may be on several alignments,
        with its own place in each. Older files: version 3 gave the routes
        (on_route, one or more) and the points with their coordinates
        inside the alignment (a point with own_routes="true" on the routes
        listed inside it); version 2 had an alignment without id inside a
        route, or the line's own. They are read into alignments and
        alignment points.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="on_route" type="ols:onRoute" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="point" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="on_route" type="ols:onRoute" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="ref" type="xs:string"/>
          <xs:attribute name="x" type="xs:double"/>
          <xs:attribute name="y" type="xs:double"/>
          <xs:attribute name="z" type="xs:double"/>
          <xs:attribute name="structure" type="xs:string"/>
          <xs:attribute name="description" type="xs:string"/>
          <xs:attribute name="own_routes" type="xs:boolean" default="false"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="route" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="alignmentPoint">
    <xs:annotation>
      <xs:documentation>An alignment point (PI): on any number of
        alignments (none: placed, waiting to be used). With "structure" it
        is tied to (and lies under) that structure and follows it.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attributeGroup ref="ols:xyz"/>
    <xs:attribute name="structure" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="tap">
    <xs:annotation>
      <xs:documentation>A jumper's tap end: a clamp on a span point
        (section, point) or on another jumper's point (jumper,
        point).</xs:documentation>
    </xs:annotation>
    <xs:attribute name="section" type="xs:string"/>
    <xs:attribute name="jumper" type="xs:string"/>
    <xs:attribute name="point" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="sectionPoint">
    <xs:annotation>
      <xs:documentation>A wire point by its structure and set (version 1
        files also give a phase).</xs:documentation>
    </xs:annotation>
    <xs:attribute name="structure" type="xs:string" use="required"/>
    <xs:attribute name="set" type="xs:unsignedInt" use="required"/>
    <xs:attribute name="phase" type="xs:unsignedInt"/>
  </xs:complexType>

  <xs:complexType name="stringing">
    <xs:annotation>
      <xs:documentation>tension: horizontal_tension and temperature (in the
        blocks). sag: sag, temperature and optionally the span (0 = first;
        none: the ruling span). unstressed_lengths: clipped in, the lengths
        of the spans at temperature, and the stringing it was sagged to
        before (a nested stringing).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="lengths" type="ols:doubleList" minOccurs="0"/>
      <xs:element name="stringing" type="ols:stringing" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="kind" type="ols:stringingKind" use="required"/>
    <xs:attribute name="horizontal_tension" type="xs:double"/>
    <xs:attribute name="sag" type="xs:double"/>
    <xs:attribute name="span" type="xs:unsignedInt"/>
    <xs:attribute name="temperature" type="xs:double" use="required"/>
  </xs:complexType>

  <!-- The document. -->

  <xs:element name="line">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="route" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>A route: a path of the line, made of the
              alignments on it. Files of version 2: the route was its own
              alignment (inside it) and listed its structures; read into
              routes and alignments.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="alignment" type="ols:alignment" minOccurs="0"/>
              <xs:element name="structure" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="ref" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="description" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="alignment" type="ols:alignment" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="alignment_point" type="ols:alignmentPoint" minOccurs="0" maxOccurs="unbounded"/>

        <xs:element name="structure" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="on_route" type="ols:onRoute" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>The routes it gives itself: needed when
                    it stands on no alignment (none: those of the alignments
                    it stands on).</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="point" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>A point of the structure where strings
                    hang (label unique among points and wire points).</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="label" type="xs:string" use="required"/>
                  <xs:attribute name="description" type="xs:string"/>
                  <xs:attributeGroup ref="ols:xyz"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="wire" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>A wire point: where strings meet; with a
                    set, where a section or jumper ends. No string to it:
                    fixed to the structure.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="label" type="xs:string" use="required"/>
                  <xs:attribute name="description" type="xs:string"/>
                  <xs:attributeGroup ref="ols:xyz"/>
                  <xs:attribute name="set" type="xs:unsignedInt"/>
                  <xs:attribute name="weight" type="xs:double" default="0"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="string" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>A string (insulator) from its top (a
                    structure point, or another string's wire point) to a
                    wire point, of a length (m) and a direction: angle_deg
                    from straight down (0 hanging, 90 level), direction_deg
                    in plan in the structure's axes (0 ahead, 90 right).
                    Its wire point is placed from them (where two strings
                    meet at one: where their lengths meet, below their
                    tops). Without a length (files written before): the
                    distance to its wire point as given.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="label" type="xs:string" use="required"/>
                  <xs:attribute name="description" type="xs:string"/>
                  <xs:attribute name="top" type="xs:string" use="required"/>
                  <xs:attribute name="wire" type="xs:string" use="required"/>
                  <xs:attribute name="length" type="xs:double"/>
                  <xs:attribute name="angle_deg" type="xs:double" default="0"/>
                  <xs:attribute name="direction_deg" type="xs:double" default="0"/>
                  <xs:attribute name="insulator" type="xs:string"/>
                  <xs:attribute name="weight" type="xs:double" default="0"/>
                  <xs:attribute name="wind_area" type="xs:double" default="0"/>
                  <xs:attribute name="stiffness" type="xs:double"/>
                  <xs:attribute name="compression" type="xs:double"/>
                  <xs:attribute name="strain" type="xs:boolean" default="false"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="attachment" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Version 1 files: a string per set and
                    phase (read as points, strings and wire points; not
                    written).</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="insulator_point" type="ols:point"/>
                    <xs:element name="wire_point" type="ols:point"/>
                    <xs:element name="leg" type="ols:point" minOccurs="0" maxOccurs="2">
                      <xs:annotation>
                        <xs:documentation>V-strings: the two legs' points on
                          the structure (both or none).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="set" type="xs:unsignedInt" use="required"/>
                  <xs:attribute name="phase" type="xs:unsignedInt" use="required"/>
                  <xs:attribute name="label" type="xs:string"/>
                  <xs:attribute name="insulator_weight" type="xs:double" default="0"/>
                  <xs:attribute name="insulator" type="xs:string"/>
                  <xs:attribute name="insulator_wind_area" type="xs:double" default="0"/>
                  <xs:attribute name="top_label" type="xs:string"/>
                  <xs:attribute name="bottom_label" type="xs:string"/>
                  <xs:attribute name="strain_member" type="xs:boolean" default="false"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="omit" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Typed structures: a point, string or
                    wire point of the type left out (label), or its wire
                    point with a set and what moves with it (set; version 1
                    files: set and phase).</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="label" type="xs:string"/>
                  <xs:attribute name="set" type="xs:unsignedInt"/>
                  <xs:attribute name="phase" type="xs:unsignedInt"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="member" type="ols:doubleList" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>A polyline of the stick drawing: x y z
                    triples.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attributeGroup ref="ols:xyz"/>
            <xs:attribute name="orientation_deg" type="xs:double" default="0"/>
            <xs:attribute name="type" type="xs:string"/>
            <xs:attribute name="extension" type="xs:string"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="height_adjust" type="xs:double" default="0">
              <xs:annotation>
                <xs:documentation>Typed structures: height of the type's feet above the ground at x y z (foundations), metres.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>

        <xs:element name="system" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="phase" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="label" type="xs:string" use="required"/>
                  <xs:attribute name="angle_deg" type="xs:double"/>
                  <xs:attribute name="polarity" type="xs:byte"/>
                  <xs:attribute name="code" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="kind" type="ols:systemKind" default="ac"/>
            <xs:attribute name="voltage_kv" type="xs:double" use="required"/>
            <xs:attribute name="frequency_hz" type="xs:double"/>
            <xs:attribute name="color" type="xs:string"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="section" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="point" type="ols:sectionPoint" minOccurs="2" maxOccurs="unbounded"/>
              <xs:element name="stringing" type="ols:stringing"/>
              <!-- Older documents: point loads of their own, read into
                   points with a body (written as span_point + object). -->
              <xs:element name="load" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="span" type="xs:unsignedInt" use="required"/>
                  <xs:attribute name="fraction" type="xs:double"/>
                  <xs:attribute name="distance" type="xs:double"/>
                  <xs:attribute name="station" type="xs:double"/>
                  <xs:attribute name="vertical" type="xs:double" use="required"/>
                  <xs:attribute name="label" type="xs:string"/>
                  <xs:attribute name="diameter" type="xs:double"/>
                  <xs:attribute name="drag" type="xs:double"/>
                  <xs:attribute name="wind_area" type="xs:double"/>
                  <xs:attribute name="ice_area" type="xs:double"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="spread_load" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Older documents (read into two points and a
                    spread): a load spread along part of a span: from start
                    to end (each a fraction of the span or a horizontal distance
                    from its back point, m), downward, N per metre of conductor
                    (the whole bundle's).</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="span" type="xs:unsignedInt" use="required"/>
                  <xs:attribute name="start_fraction" type="xs:double"/>
                  <xs:attribute name="start_distance" type="xs:double"/>
                  <xs:attribute name="start_station" type="xs:double"/>
                  <xs:attribute name="end_fraction" type="xs:double"/>
                  <xs:attribute name="end_distance" type="xs:double"/>
                  <xs:attribute name="end_station" type="xs:double"/>
                  <xs:attribute name="load" type="xs:double" use="required"/>
                  <xs:attribute name="label" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="span_point" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>A labelled point on a span (fraction of the
                    span, distance from its back point, or station), with its
                    object (a body or a clamp) or bare.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="object" type="ols:object" minOccurs="0"/>
                  </xs:sequence>
                  <xs:attribute name="label" type="xs:string" use="required"/>
                  <xs:attribute name="span" type="xs:unsignedInt" use="required"/>
                  <xs:attribute name="fraction" type="xs:double"/>
                  <xs:attribute name="distance" type="xs:double"/>
                  <xs:attribute name="station" type="xs:double"/>
                  <xs:attribute name="description" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="spread" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>An object spread between two points of one
                    span (from, to: their labels): downward, N per metre of
                    conductor — the whole bundle's, or each subconductor's
                    when per_subconductor (the bundle carrying load ×
                    bundle).</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="label" type="xs:string"/>
                  <xs:attribute name="from" type="xs:string" use="required"/>
                  <xs:attribute name="to" type="xs:string" use="required"/>
                  <xs:attribute name="type" type="xs:string"/>
                  <xs:attribute name="load" type="xs:double" use="required"/>
                  <xs:attribute name="per_subconductor" type="xs:boolean" default="false"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="cable" type="xs:string" use="required"/>
            <!-- The name of its circuit (before version 5: `circuit`,
                 still read). -->
            <xs:attribute name="circuit_name" type="xs:string"/>
            <xs:attribute name="circuit" type="xs:string"/>
            <xs:attribute name="phase_label" type="xs:string"/>
            <xs:attribute name="system" type="xs:string"/>
            <xs:attribute name="bundle" type="xs:unsignedInt" default="1"/>
            <xs:attribute name="bundle_spacing" type="xs:double"/>
            <xs:attribute name="bundle_rotation_deg" type="xs:double"/>
            <xs:attribute name="color" type="ols:color"/>
            <xs:attribute name="calculation" type="ols:calculation" default="initial-fe"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="jumper" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <!-- Each end: a wire point (`from` / `to`), or a tap
                   (`from_tap` / `to_tap`): a clamp on a span point
                   (section, point) or on another jumper's point (jumper,
                   point). Files before version 5 gave a placeholder `from`
                   beside a tap; the tap is read. -->
              <xs:choice>
                <xs:element name="from" type="ols:sectionPoint"/>
                <xs:element name="from_tap" type="ols:tap"/>
              </xs:choice>
              <xs:choice>
                <xs:element name="to" type="ols:sectionPoint"/>
                <xs:element name="to_tap" type="ols:tap"/>
              </xs:choice>
              <xs:element name="support" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="length" type="xs:double" use="required"/>
                  <xs:attribute name="weight" type="xs:double" default="0"/>
                  <xs:attribute name="fraction" type="xs:double" default="0.5"/>
                  <xs:attributeGroup ref="ols:xyz"/>
                </xs:complexType>
              </xs:element>
              <!-- Before version 5: a support string (`support`) and support
                   clamps (`clamp`, in order from `from`: each on the strings
                   to a wire point without a set) of their own; read as
                   jumper points holding a held clamp, not written. -->
              <xs:element name="clamp" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="structure" type="xs:string"/>
                  <xs:attribute name="wire" type="xs:string" use="required"/>
                  <xs:attribute name="at" type="xs:double" use="required"/>
                  <xs:attribute name="clamp_length" type="xs:double" default="0.1"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="jumper_point" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>A labelled point along the jumper (from
                    `from`: fraction of its length, a length along it, or a
                    horizontal distance from `from`'s clamp), with its object
                    or bare.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="object" type="ols:object" minOccurs="0"/>
                  </xs:sequence>
                  <xs:attribute name="label" type="xs:string" use="required"/>
                  <xs:attribute name="fraction" type="xs:double" default="0"/>
                  <xs:attribute name="length" type="xs:double"/>
                  <xs:attribute name="distance" type="xs:double"/>
                  <xs:attribute name="description" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="cable" type="xs:string" use="required"/>
            <xs:attribute name="length" type="xs:double"/>
            <xs:attribute name="sag" type="xs:double"/>
            <xs:attribute name="temperature" type="xs:double" default="15"/>
            <xs:attribute name="bending_stiffness" type="xs:double"/>
            <xs:attribute name="stiffness_factor" type="xs:double"/>
            <xs:attribute name="rigid" type="xs:boolean"/>
            <xs:attribute name="angle_from_deg" type="xs:double"/>
            <xs:attribute name="angle_to_deg" type="xs:double"/>
            <xs:attribute name="color" type="ols:color"/>
            <xs:attribute name="bundle" type="xs:unsignedInt"/>
            <xs:attribute name="bundle_spacing" type="xs:double"/>
            <xs:attribute name="bundle_rotation_deg" type="xs:double"/>
          </xs:complexType>
        </xs:element>

        <!-- An end of an electrical circuit (a conductor path) that is a start;
             a circuit none of whose ends is listed runs along the line. -->
        <xs:element name="spacer" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>An interphase spacer: an insulator between span
              points of two sections of the same span (both solved by finite
              elements). compression: what it may take, N (none: tension
              only).</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="end" minOccurs="2" maxOccurs="2">
                <xs:complexType>
                  <xs:attribute name="section" type="xs:string" use="required"/>
                  <xs:attribute name="point" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="field" type="ols:field" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="insulator" type="xs:string"/>
            <xs:attribute name="length" type="xs:double"/>
            <xs:attribute name="weight" type="xs:double"/>
            <xs:attribute name="wind_area" type="xs:double"/>
            <xs:attribute name="stiffness" type="xs:double"/>
            <xs:attribute name="compression" type="xs:double"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="circuit_start" type="ols:sectionPoint" minOccurs="0" maxOccurs="unbounded"/>

        <xs:element name="phase_color" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="label" type="xs:string" use="required"/>
            <xs:attribute name="color" type="ols:color" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="creep_stretch" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="load_case" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="creep_case" type="xs:string"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="defaults" minOccurs="0">
          <xs:annotation>
            <xs:documentation>The project's default values (Criteria › Default
              values), SI units, only those not the program's: what new
              objects start with and what the calculations take where an
              object, a cable, a case or a rule file gives no value
              (ols_line::DEFAULT_FIELDS, `section_key`).</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:attribute name="spacer_compression" type="xs:double" default="10000"/>
            <xs:attribute name="jumper_exit_angle" type="xs:double" default="30"/>
            <xs:attribute name="jumper_stiffness_factor" type="xs:double" default="0.2"/>
            <xs:attribute name="jumper_clamp_length" type="xs:double" default="0.1"/>
            <xs:attribute name="insulator_stiffness" type="xs:double" default="50000000"/>
            <xs:attribute name="weather_air_density_factor" type="xs:double" default="0.613"/>
            <xs:attribute name="thermal_emissivity" type="xs:double" default="0.8"/>
            <xs:attribute name="thermal_absorptivity" type="xs:double" default="0.8"/>
            <xs:attribute name="thermal_roughness" type="xs:double" default="0.1"/>
            <xs:attribute name="thermal_albedo" type="xs:double" default="0.1"/>
            <xs:attribute name="thermal_time_step" type="xs:double" default="10"/>
            <xs:attribute name="clearance_wind_step" type="xs:double" default="50"/>
            <xs:attribute name="clearance_vertical_band" type="xs:double" default="0.5"/>
            <xs:attribute name="clearance_search_margin" type="xs:double" default="5"/>
            <xs:attribute name="clearance_zone_width" type="xs:double" default="1"/>
            <xs:attribute name="clearance_zone_depth" type="xs:double" default="0.2"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="solver" minOccurs="0">
          <xs:annotation>
            <xs:documentation>How the calculations are done (Criteria ›
              Calculation options). jumper_loads: what of the jumpers the
              sections carry at their clamps — an estimate (the default:
              the weight, ice and wind of the part each end carries) or the
              jumper's own pull (its solved end forces, the sections and
              jumpers solved in turn until they settle).</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:attribute name="jumper_loads" default="estimate">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="estimate"/>
                  <xs:enumeration value="pull"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <!-- Jumpers on taps: the full loop (default) or one calculation. -->
            <xs:attribute name="taps" default="loop">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="loop"/>
                  <xs:enumeration value="once"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>

        <xs:element name="bimetallic" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="behavior" default="compression">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="compression"/>
                  <xs:enumeration value="bird_cage"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="max_virtual_compression_pa" type="xs:double"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="structure_loads" minOccurs="0">
          <xs:annotation>
            <xs:documentation>What the line sends to the placed structures
              (Criteria › Loads for structures): the load cases (all, or
              those listed as load_case) and the weather cases sent on their
              own (weather_case, each a case with all factors 1, after the
              load cases).</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="load_case" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="weather_case" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="load_cases" default="all">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="all"/>
                  <xs:enumeration value="listed"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="format" type="xs:string" fixed="ols-line"/>
      <!-- The line file version (now 5), not the namespace's 1. -->
      <xs:attribute name="version" type="xs:unsignedInt" default="1"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="crs" type="xs:string"/>
      <xs:attribute name="ahead_deg" type="xs:double" default="0">
        <xs:annotation>
          <xs:documentation>Angles in plan around a structure turn clockwise seen from above; this one means ahead along the line (0: ahead 0°, right 90°; 270: right 0°, ahead 270°).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
