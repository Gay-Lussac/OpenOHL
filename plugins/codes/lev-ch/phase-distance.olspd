# Distance between conductors in the span (still air), Swiss LeV
# (SR 734.31), Annex 6, 2.2.1:
#   z = k · sqrt(f + l_k) + C
# Table 2.4.1 by nominal voltage: C1 within one electrical system and
# towards earth (earth wires, earthed parts), C2 between different
# systems; C3 and C4 the same for brief approaches (e.g. wind
# deflection; their 50-Hz test voltages are not kept here). Where the
# insulation level gives two lines, each value has two (low, high), and
# c1_bil_kv / c2_bil_kv give the lightning impulse withstand voltage C1
# and C2 are for. A voltage between rows takes the next row up. k:
# Diagrams 2.4.2 (500 N/m²) and 2.4.3 (650 N/m²), linear in the system angle β
# (0°: one conductor above the other, 90°: side by side), one line per
# swing class w = d/q (d in mm, q in kg/m), up to w_max.
# Swiss legislation is not protected by copyright; values from the
# official text (Table 2.4.1, consolidated version of 1 June 2019 on
# fedlex.admin.ch). See docs/development/lev-phase-spacing.md.

format = "ols-phase-distance"
version = 1
name = "LeV Annex 6 (SR 734.31): conductors in the span"

[altitude]
from = "1000 m"     # the values hold up to here
per_1000_m = 0.14   # above: +14 % per 1000 m

[[voltage]]
kv = 1              # below 1 kV
c1 = ["0.05 m"]
c2 = ["0.05 m"]
c3 = ["0.05 m"]
c4 = ["0.05 m"]

[[voltage]]
kv = 3
c1 = ["0.06 m"]
c1_bil_kv = [40]
c2 = ["0.06 m"]
c2_bil_kv = [46]
c3 = ["0.06 m"]
c4 = ["0.06 m"]

[[voltage]]
kv = 6
c1 = ["0.09 m"]
c1_bil_kv = [60]
c2 = ["0.09 m"]
c2_bil_kv = [70]
c3 = ["0.09 m"]
c4 = ["0.09 m"]

[[voltage]]
kv = 10
c1 = ["0.12 m"]
c1_bil_kv = [75]
c2 = ["0.12 m"]
c2_bil_kv = [85]
c3 = ["0.12 m"]
c4 = ["0.12 m"]

[[voltage]]
kv = 15
c1 = ["0.16 m"]
c1_bil_kv = [95]
c2 = ["0.17 m"]
c2_bil_kv = [110]
c3 = ["0.16 m"]
c4 = ["0.16 m"]

[[voltage]]
kv = 20
c1 = ["0.22 m"]
c1_bil_kv = [125]
c2 = ["0.26 m"]
c2_bil_kv = [145]
c3 = ["0.18 m"]
c4 = ["0.18 m"]

[[voltage]]
kv = 30
c1 = ["0.32 m"]
c1_bil_kv = [170]
c2 = ["0.39 m"]
c2_bil_kv = [195]
c3 = ["0.21 m"]
c4 = ["0.24 m"]

[[voltage]]
kv = 45
c1 = ["0.52 m"]
c1_bil_kv = [250]
c2 = ["0.63 m"]
c2_bil_kv = [290]
c3 = ["0.30 m"]
c4 = ["0.36 m"]

[[voltage]]
kv = 60
c1 = ["0.70 m"]
c1_bil_kv = [325]
c2 = ["0.82 m"]
c2_bil_kv = [375]
c3 = ["0.45 m"]
c4 = ["0.52 m"]

# 110 and 132 kV: C1 and C3 of their own (450 / 550 kV), C2 and C4 the
# same (650 kV); one line each (no insulation levels).
[[voltage]]
kv = 110
c1 = ["0.92 m"]
c1_bil_kv = [450]
c2 = ["1.38 m"]
c2_bil_kv = [650]
c3 = ["0.61 m"]
c4 = ["0.89 m"]

[[voltage]]
kv = 132
c1 = ["1.12 m"]
c1_bil_kv = [550]
c2 = ["1.38 m"]
c2_bil_kv = [650]
c3 = ["0.76 m"]
c4 = ["0.89 m"]

[[voltage]]
kv = 150
c1 = ["1.32 m"]
c1_bil_kv = [650]
c2 = ["1.64 m"]
c2_bil_kv = [750]
c3 = ["0.92 m"]
c4 = ["1.05 m"]

[[voltage]]
kv = 220
c1 = ["1.93 m", "2.14 m"]
c1_bil_kv = [950, 1050]
c2 = ["2.29 m", "2.56 m"]
c2_bil_kv = [1050, 1175]
c3 = ["1.35 m", "1.60 m"]
c4 = ["1.60 m", "1.90 m"]

[[voltage]]
kv = 380
c1 = ["2.64 m", "2.90 m"]
c1_bil_kv = [1300, 1425]
c2 = ["3.37 m", "3.64 m"]
c2_bil_kv = [1550, 1675]
c3 = ["2.09 m", "2.33 m"]
c4 = ["2.30 m", "2.86 m"]

[[diagram]]
name = "2.4.2 (500 N/m²)"
wind_pressure = "500 Pa"
line = [
    { w_max = 16.8, k0 = 0.70, k90 = 0.60 },   # swing ≤ 40°
    { w_max = 28.5, k0 = 0.75, k90 = 0.65 },   # 40°–55°
    { w_max = 42.8, k0 = 0.85, k90 = 0.70 },   # 55°–65°
    { k0 = 0.95, k90 = 0.75 },                 # > 65°
]

[[diagram]]
name = "2.4.3 (650 N/m²)"
wind_pressure = "650 Pa"
line = [
    { w_max = 12.9, k0 = 0.70, k90 = 0.60 },
    { w_max = 22.0, k0 = 0.75, k90 = 0.65 },
    { w_max = 33.0, k0 = 0.85, k90 = 0.70 },
    { k0 = 0.95, k90 = 0.75 },
]
