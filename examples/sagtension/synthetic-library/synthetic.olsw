# OLS CAD wire library (.olsw)
format = "ols-wire"
version = 1

# SYNTHETIC test cable — invented curves to exercise the non-linear model.
# NOT real conductor data; never use for design.

[[cable]]
id = "synthetic"
name = "Synthetic ACSR-like test cable"
kind = "acsr"
source = "Synthetic test data — not a real conductor"
diameter = "28 mm"
mass_per_length = "1.6 kg/m"
rated_tensile_strength = "140 kN"

[cable.outer]
area = "400 mm²"
modulus = "55 GPa"
thermal_expansion = 23.0e-6
[cable.outer.stress_strain]
stress_unit = "MPa"
initial = [0.0, 250.0, -110.0, 40.0, -8.0]
creep = [0.0, 160.0, -60.0, 15.0, -2.0]
final_modulus = 550.0
max_compression = 0.0
max_strain = 0.9

[cable.core]
area = "65 mm²"
modulus = "190 GPa"
thermal_expansion = 11.5e-6
[cable.core.stress_strain]
stress_unit = "MPa"
initial = [0.0, 1800.0, -120.0, 30.0, -5.0]
final_modulus = 1900.0
