# Starter template: weather cases for learning (INVENTED values, not a
# design code). Replace them with the cases of the design code you use.
# Ice either as a radial thickness with a density, or as a load per metre.
format = "ohl-weather-cases"
version = 1
name = "Starter weather cases (invented)"

[[case]]
name = "everyday"
description = "still air, the stringing condition"
tags = ["stringing"]
temperature = "10 °C"

[[case]]
name = "max temperature"
description = "maximum conductor temperature"
tags = ["clearance"]
temperature = "80 °C"

[[case]]
name = "glaze ice"
tags = ["clearance", "loads"]
temperature = "-5 °C"
ice_thickness = "12.7 mm"
ice_density = "913 kg/m³"

[[case]]
name = "high wind"
tags = ["loads", "blowout"]
temperature = "15 °C"
wind_pressure = "600 Pa"

[[case]]
name = "minimum temperature"
tags = ["uplift"]
temperature = "-20 °C"
