# Pylon template (see delta-1c.olspt for the conventions).
# Circuit 1 on the left (slots 1-3, top to bottom), circuit 2 on the right (4-6).
format = "ols-pylon-template"
version = 1
id = "barrel-2c"
name = "Barrel, two circuits, one earth wire"
description = "Three crossarms, one phase of each circuit on each side; the middle arm the longest; an earth wire at the peak."
kind = "lattice"
height = "peak"

[strings]
suspension_length = "4 m"
suspension_weight = "1.5 kN"
strain_length = "5 m"
strain_weight = "2 kN"

[[parameter]]
name = "level_1"
default = "45 m"
description = "height of the top crossarm"

[[parameter]]
name = "level_2"
default = "37 m"
description = "height of the middle crossarm"

[[parameter]]
name = "level_3"
default = "29 m"
description = "height of the bottom crossarm"

[[parameter]]
name = "half_1"
default = "6 m"
description = "top crossarm: mast to each phase"

[[parameter]]
name = "half_2"
default = "9 m"
description = "middle crossarm: mast to each phase"

[[parameter]]
name = "half_3"
default = "7 m"
description = "bottom crossarm: mast to each phase"

[[parameter]]
name = "peak"
default = "53 m"
description = "height of the peak (earth wire)"

[[attachment]]
slot = 1
label = "C1-L1"
across = "-half_1"
up = "level_1"

[[attachment]]
slot = 2
label = "C1-L2"
across = "-half_2"
up = "level_2"

[[attachment]]
slot = 3
label = "C1-L3"
across = "-half_3"
up = "level_3"

[[attachment]]
slot = 4
label = "C2-L1"
across = "half_1"
up = "level_1"

[[attachment]]
slot = 5
label = "C2-L2"
across = "half_2"
up = "level_2"

[[attachment]]
slot = 6
label = "C2-L3"
across = "half_3"
up = "level_3"

[[earth]]
slot = 19
label = "E1"
across = "0"
up = "peak"
