# OpenOHL structure model (.ohlfe): the finite-element model of the
# synthetic type-02 pylon on its own, as a type names it with
# `model = "type-02-model.ohlfe"` (type-02.ohls holds the same tables
# itself, a full design). Invented values, NOT a real design.
format = "ohl-structure-model"
version = 1
name = "type-02 pylon (synthetic example)"

[analysis]
nonlinear = true
self_weight = true

[[material]]
id = "steel"
elasticity = "210 GPa"
shear_modulus = "81 GPa"
density = "7850 kg/m3"
yield = "355 MPa"

[[section]]
id = "leg"
material = "steel"
area = "1500 mm2"
i_min = "80 cm4"

[[section]]
id = "brace"
material = "steel"
area = "600 mm2"
i_min = "25 cm4"

[[section]]
id = "arm"
material = "steel"
area = "1000 mm2"
i_min = "40 cm4"

