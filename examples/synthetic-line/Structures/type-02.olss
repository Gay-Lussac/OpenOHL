# Derived from the geometry of an existing line — check and complete.
format = "ols-structure"
version = 2
id = "type-02"
name = "type-02 (2 structures, e.g. T2)"
kind = "other"
source = "derived from: T2, T4"
# Finite-element check: the invented lattice model next to this file.
model = "type-02.olsfe"

[[point]]
label = "A1"
point = ["6.000 m", "0.000 m", "30.000 m"]

[[wire]]
label = "W1"
set = 1

[[string]]
label = "S1"
top = "A1"
wire = "W1"
length = "3.500 m"
weight = "900.0 N"

[[point]]
label = "A11"
point = ["-6.000 m", "0.000 m", "30.000 m"]

[[wire]]
label = "W11"
set = 11

[[string]]
label = "S11"
top = "A11"
wire = "W11"
length = "3.500 m"
weight = "900.0 N"

# Capacity (invented values for the example): allowable spans by line
# angle (Method 1) and allowable loads per attachment (Method 2).

[[capacity.spans]]
angle = "0 deg"
wind_span = "400 m"
weight_span = "600 m"

[[capacity.spans]]
angle = "5 deg"
wind_span = "350 m"
weight_span = "600 m"

[[capacity.attachment]]
point = "A1"
vertical = "10 kN"
transverse = "10 kN"
longitudinal = "5 kN"

[[capacity.attachment]]
point = "A11"
vertical = "10 kN"
transverse = "10 kN"
longitudinal = "5 kN"

# Wind on the structure (invented values for the example).

[[wind.band]]
from = "0 m"
to = "15 m"
area = "9 m²"
drag = 3.0

[[wind.band]]
from = "15 m"
to = "30 m"
area = "6 m²"
drag = 3.0
