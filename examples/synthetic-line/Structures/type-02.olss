# Derived from the geometry of an existing line — check and complete.
format = "ols-structure"
version = 1
id = "type-02"
name = "type-02 (2 structures, e.g. T2)"
kind = "other"
source = "derived from: T2, T4"
# Finite-element check: the invented lattice model next to this file.
model = "type-02.olsfe"

[[attachment]]
set = 1
phase = 1
label = "suspension"
point = ["6.000 m", "0.000 m", "30.000 m"]
string = { length = "3.500 m", weight = "900.0 N", top = "A1-1", bottom = "W1-1" }

[[attachment]]
set = 1
phase = 2
label = "suspension"
point = ["-6.000 m", "0.000 m", "30.000 m"]
string = { length = "3.500 m", weight = "900.0 N", top = "A1-2", bottom = "W1-2" }

# Capacity (invented values for the example): allowable spans by line
# angle (Method 1) and allowable loads per attachment (Method 2).

[[capacity.spans]]
angle = "0 deg"
wind_span = "400 m"
weight_span = "600 m"

[[capacity.spans]]
angle = "5 deg"
wind_span = "350 m"
weight_span = "600 m"

[[capacity.attachment]]
set = 1
phase = 1
vertical = "10 kN"
transverse = "10 kN"
longitudinal = "5 kN"

[[capacity.attachment]]
set = 1
phase = 2
vertical = "10 kN"
transverse = "10 kN"
longitudinal = "5 kN"
