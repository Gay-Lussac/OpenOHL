# Derived from the geometry of an existing line — check and complete.
format = "ols-structure"
version = 1
id = "type-05"
name = "type-05 (1 structures, e.g. T6)"
kind = "other"
source = "derived from: T6"
# Pole check: the invented steel pole of steel-pole-30m.olsp.
pole = "steel-pole-30m"

[[attachment]]
set = 1
phase = 1
label = "suspension"
point = ["0.000 m", "0.000 m", "26.000 m"]
string = { length = "3.500 m", weight = "900.0 N", top = "A1-1", bottom = "W1-1" }

# Capacity (invented values for the example): allowable spans by line
# angle (Method 1) and allowable loads per attachment (Method 2).

[[capacity.spans]]
angle = "0 deg"
wind_span = "350 m"
weight_span = "500 m"

[[capacity.attachment]]
set = 1
phase = 1
vertical = "8 kN"
transverse = "8 kN"
longitudinal = "5 kN"
