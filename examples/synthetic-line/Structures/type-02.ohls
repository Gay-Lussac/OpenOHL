# The model's own load case (ohl structures fe without --loads): wires
# and wind at both attachments, structure axes (z up), invented values.
[[load]]
node = "A1"
force = ["4 kN", "0 kN", "-9 kN"]

[[load]]
node = "A2"
force = ["4 kN", "0 kN", "-9 kN"]

# The structure's own load cases (recipes; invented, NOT from a design
# code): each load says what the line gives at the placed structure, how
# it acts and where. The structure application evaluates them with the
# loads of each placed structure (T2, T4) into its load table; the
# [[load]] tables above are its case "model".
[[load_case]]
name = "wind"
description = "the line's wind case, factored as in the line"
line_case = "wind"

[[load_case.load]]
what = "transverse_factored"
points = "all"

[[load_case.load]]
what = "longitudinal_factored"
points = "all"

[[load_case.load]]
what = "vertical_factored"
points = "all"

[[load_case]]
name = "ice, unbalanced"
description = "the ice case's vertical loads × 1.3, and 2 kN along the line at set 1"
line_case = "ice"
strength = 0.9

[[load_case.load]]
what = "vertical"
factor = 1.3
points = "all"

[[load_case.load]]
value = "2 kN"
direction = "y"
sets = [1]

[[load_case]]
name = "body wind"
description = "a pressure on the members' area (areas come with the section library)"

[[load_case.load]]
pressure = "0.6 kPa"
direction = "x"
members = "all"

# A case of the two parts (2026-10-25; invented factors, NOT from a
# design code): the line forces of a line result, a factor per axis, and
# the loads on the structure itself. The cases above are in the older
# form (still read and evaluated).
[[load_case]]
name = "high wind, from the left"
description = """The line's high wind from the left, invented factors.
Mirror wind makes the case from the right."""

[[load_case.line]]
result = "high wind — wind from the left"
vertical = 1.2
transverse = 1.4
longitudinal = 1.0

[load_case.structure]
self_weight = 1.2

[[load_case.structure.wind]]
from = "left"
pressure_of = "high wind — wind from the left"
factor = 1.4

[[load_case.structure.point]]
value = "1 kN"
direction = "down"
points = ["A1"]
