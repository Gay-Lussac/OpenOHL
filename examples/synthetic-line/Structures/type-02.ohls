# Derived from the geometry of an existing line — check and complete.
format = "ohl-structure"
version = 7
id = "type-02"
name = "type-02 (2 structures, e.g. T2)"
kind = "other"
source = "derived from: T2, T4"

[[point]]
label = "A1"
node = "A1"                          # at the right arm's tip (6 m, 0, 30 m)

[[wire]]
label = "W1"
set = 1

[[string]]
label = "S1"
top = "A1"
wire = "W1"
length = "3.500 m"
weight = "900.0 N"

[[point]]
label = "A11"
node = "A2"                          # at the left arm's tip (-6 m, 0, 30 m)

[[wire]]
label = "W11"
set = 11

[[string]]
label = "S11"
top = "A11"
wire = "W11"
length = "3.500 m"
weight = "900.0 N"

# Capacity (invented values for the example): allowable spans by line
# angle (Method 1) and allowable loads per attachment (Method 2).

[[capacity.spans]]
angle = "0 deg"
wind_span = "400 m"
weight_span = "600 m"

[[capacity.spans]]
angle = "5 deg"
wind_span = "350 m"
weight_span = "600 m"

[[capacity.attachment]]
point = "A1"
vertical = "10 kN"
transverse = "10 kN"
longitudinal = "5 kN"

[[capacity.attachment]]
point = "A11"
vertical = "10 kN"
transverse = "10 kN"
longitudinal = "5 kN"

# Wind on the structure (invented values for the example).

[[wind.band]]
from = "0 m"
to = "15 m"
area = "9 m²"
drag = 3.0

[[wind.band]]
from = "15 m"
to = "30 m"
area = "6 m²"
drag = 3.0

# The structure (invented, NOT a real design): a square, tapered body of 10
# panels with X-bracing, plan bracing and two crossarms carrying the
# points. Every member has a cross-section and the feet are supported, so the
# type is a full design (detail 3) and the finite-element check uses it.
# Section values are round invented numbers; a real model takes them from
# the steel supplier's tables.

[analysis]
nonlinear = true
self_weight = true

[[material]]
id = "steel"
elasticity = "210 GPa"
shear_modulus = "81 GPa"
density = "7850 kg/m3"
yield = "355 MPa"

[[section]]
id = "leg"
material = "steel"
area = "1500 mm2"
i_min = "80 cm4"

[[section]]
id = "brace"
material = "steel"
area = "600 mm2"
i_min = "25 cm4"

[[section]]
id = "arm"
material = "steel"
area = "1000 mm2"
i_min = "40 cm4"

