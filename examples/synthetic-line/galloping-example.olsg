# Example galloping parameters for the synthetic line.
#
# INVENTED VALUES — NOT FROM ANY STANDARD OR PUBLICATION. They only show the
# form of the file. Take the coefficients of the method you design to (e.g.
# A. E. Davison 1939; RUS Bulletin 1724E-200; CIGRE TB 322) from the source
# itself, and check them against it.
#
#   ols clearance galloping synthetic-line.ols.json \
#       --weather weather-cases.olswc --params galloping-example.olsg
format = "ols-galloping"
version = 1
name = "Example galloping ellipses (invented values)"
# Ellipses of two wires must stay this far apart (or by voltage, as in rule
# files: { by_voltage = [[0, "0.2 m"], [245, "0.5 m"]] }).
required = "0.3 m"
pair_voltage = "higher"
stations = 20
# The weather case the wires gallop in (light ice, little wind).
cases = ["glaze*"]

[[method]]
name = "single loop (example)"
loops = 1
# Major axis A = 1.2 · sag + 0.3 m (invented).
major = { sag = 1.2, constant = "0.3 m" }
# Minor axis B = 0.4 · A (invented).
minor = { major = 0.4 }
# Major axis 10° from vertical, top to the right; the wire at rest a
# quarter of A above the ellipse's lower end (centre 0.25 A above it).
tilt = 10.0
centre_above_rest = 0.25
along = "sine"

[[method]]
name = "two loops (example)"
loops = 2
# A = 0.5 · sag + 0.2 m, B = 0.5 · A (invented).
major = { sag = 0.5, constant = "0.2 m" }
minor = { major = 0.5 }
tilt = 0.0
centre_above_rest = 0.25
along = "sine"
