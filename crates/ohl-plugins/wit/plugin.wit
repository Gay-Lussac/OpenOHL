// (ADR-0011): a plugin built on it may keep any licence.

// OpenOHL plugin interface (ADR-0003).
//
// This is the stable contract between OpenOHL and WebAssembly plugins.
// Breaking changes require a new major version of the package.

package ohl:plugin@0.1.0;

/// Types shared by all plugins.
interface types {
    /// Identity of a plugin, reported to the host when it is loaded.
    record plugin-info {
        /// Unique plugin name, e.g. "acme-marker-balls".
        name: string,
        /// Plugin version (semantic versioning).
        version: string,
        /// One-line description.
        description: string,
    }
}

/// Minimal world every WebAssembly plugin implements.
///
/// Extension-point interfaces (cable models, design codes, checks, …) will be
/// added as further exports in later versions.
world plugin {
    use types.{plugin-info};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    /// Example numeric entry point: total load of a uniformly distributed
    /// load `load-per-meter` (N/m) over `span-length` (m), in N.
    export span-load: func(load-per-meter: f64, span-length: f64) -> f64;
}

/// Types of file-format plugins (exporters and importers).
interface io-types {
    /// What a format does.
    enum direction {
        /// Writes a file from a (solved) model.
        exporter,
        /// Reads a file into a line.
        importer,
    }

    /// A file format provided by a plugin.
    record format {
        /// Unique id, e.g. "geojson".
        id: string,
        /// One-line description.
        description: string,
        /// File extension, without the dot.
        extension: string,
        /// Exporter or importer.
        direction: direction,
    }
}

/// World of file-format plugins: export a solved model, import a file.
///
/// The export model is JSON (format "ohl-export-model", documented in the
/// OpenOHL plugin guide): the line file, its coordinate system and, per
/// weather case, the solved wires as polylines.
world io-plugin {
    use types.{plugin-info};
    use io-types.{format};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    /// The formats this plugin provides.
    export formats: func() -> list<format>;

    /// Writes the model in format `format` (an exporter's id); `options`
    /// are key/value pairs given by the user.
    export export-model: func(format: string, model: string, options: list<tuple<string, string>>) -> result<list<u8>, string>;

    /// Reads `data` in format `format` (an importer's id) and returns a line
    /// file (.ohl.json) as JSON.
    export import-file: func(format: string, data: list<u8>, options: list<tuple<string, string>>) -> result<string, string>;
}

/// Types of terrain plugins.
interface terrain-types {
    /// A terrain surface (TIN): points as x, y, z one after the other
    /// (metres, x east, y north, z up), triangles as three point indices
    /// each (from 0).
    record surface {
        /// Name (e.g. from the file).
        name: string,
        /// x0, y0, z0, x1, y1, z1, …
        points: list<f64>,
        /// a0, b0, c0, a1, b1, c1, …
        triangles: list<u32>,
    }
}

/// World of terrain plugins: read terrain surfaces (TINs) from files.
world terrain-plugin {
    use types.{plugin-info};
    use io-types.{format};
    use terrain-types.{surface};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    /// The surface formats this plugin reads (importers).
    export formats: func() -> list<format>;

    /// Reads the surfaces of `data` in format `format`.
    export import-surfaces: func(format: string, data: list<u8>, options: list<tuple<string, string>>) -> result<list<surface>, string>;
}

/// Types of project plugins.
interface project-types {
    /// A library file of the project (as OpenOHL writes them).
    record library-file {
        /// Library kind: "cables" (.ohlw), "weather" (.ohlwc),
        /// "loadcases" (.ohllc), "structures" (.ohls), "insulators"
        /// (.ohli), "rules" (.ohlr), "galloping" (.ohlg), "ambient"
        /// (.ohlta), "costs" (.ohlcost), "poles" (.ohlp), "femodels"
        /// (.ohlfe).
        kind: string,
        /// File name, with its extension.
        name: string,
        /// The file's text (TOML).
        text: string,
    }

    /// A project read from another program's file.
    record project {
        /// The line, as a line file (.ohl.json) in JSON.
        line: string,
        /// Its libraries.
        libraries: list<library-file>,
        /// What was read, what was left out or assumed (shown to the user).
        notes: list<string>,
    }
}

/// World of project plugins: read a whole project (line and libraries)
/// from another program's file.
world project-plugin {
    use types.{plugin-info};
    use io-types.{format};
    use project-types.{project};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    /// The project formats this plugin reads (importers).
    export formats: func() -> list<format>;

    /// Reads a project from `data` in format `format`.
    export import-project: func(format: string, data: list<u8>, options: list<tuple<string, string>>) -> result<project, string>;
}

/// Sheet templates a plugin offers as presets: page, title block, logos,
/// band rows, legend, key map, the styles of the line's kinds and
/// versions — everything of a plan and profile sheet (optional export of
/// any plugin, extension point `sheet-templates`). Added in interface
/// version 0.3 without changing anything else: plugins built before load
/// as they are, and give none.
interface sheet-templates {
    /// An image a template names (`image = "logo.svg"` in a title block
    /// cell).
    record sheet-image {
        /// The name the template uses, e.g. "logo.svg".
        name: string,
        /// "image/svg+xml", "image/png" or "image/jpeg".
        media-type: string,
        /// The file's bytes.
        bytes: list<u8>,
    }

    /// A sheet template preset.
    record sheet-template {
        /// Name, unique among the plugin's templates (e.g. "a1-standard").
        name: string,
        /// What it is for, shown before it is chosen.
        description: string,
        /// The template, as a sheet template file (.ohlsheet, TOML,
        /// format `ohl-sheet-template`).
        template: string,
        /// The images it names.
        images: list<sheet-image>,
    }

    /// The plugin's sheet templates. The error says why there are none.
    sheet-templates: func() -> result<list<sheet-template>, string>;
}

/// A plugin that gives sheet templates only (extension point
/// `sheet-templates`).
world sheet-template-plugin {
    use types.{plugin-info};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    export sheet-templates;
}

/// The `sheet-templates` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world sheet-templates-export {
    export sheet-templates;
}
