// file, You can obtain one at https://mozilla.org/MPL/2.0/.
// The plugin interface stays MPL-2.0 while OpenOHL is AGPL-3.0-or-later
// (ADR-0011): a plugin built on it may keep any licence.

// OpenOHL design-code plugin interface (ADR-0003), part of package
// ohl:plugin (declared in plugin.wit).
//
// A design-code plugin turns the user's parameter file (TOML, every value
// taken from the standard and its national annex by the user) into weather
// cases and load cases, and may give presets of the clearance windows
// and (optional export `rule-presets`) presets of any clearance rule set.
// OpenOHL ships no code tables.

/// Types of design-code plugins.
interface code-types {
    /// Identity of a design-code plugin.
    record code-info {
        /// Unique plugin name, e.g. "en50341".
        name: string,
        /// Plugin version (semantic versioning).
        version: string,
        /// One line: the code and what is generated.
        description: string,
        /// A parameter file to start from (TOML, every value a placeholder
        /// to be replaced from the standard), its schema in comments.
        parameters-template: string,
    }

    /// The clearance window a preset is for.
    enum clearance-measure {
        /// Vertical clearances… (the zone under the wire).
        vertical,
        /// Radial clearances… (the direct 3D distance).
        radial,
    }

    /// A preset of a clearance window (Vertical clearances…, Radial
    /// clearances…): its rules and the weather cases they name, loaded in
    /// one click; the user may change both afterwards.
    record clearance-preset {
        /// Name, unique among the plugin's presets (e.g. "vertical").
        name: string,
        /// The window it is for.
        measure: clearance-measure,
        /// The rules, as a clearance rule file (.ohlr, TOML, format
        /// `ohl-clearance-rules`), with its `[wind]` and `[check]` tables
        /// (the wind steps and sides, the circuits, the calculation
        /// method, the search distance).
        rules: string,
        /// The weather cases its rules name, as a weather case file
        /// (.ohlwc, TOML).
        weather-cases: string,
    }

    /// What a design code generated from a parameter file.
    record generated {
        /// Weather cases, as a weather case file (.ohlwc, TOML).
        weather-cases: string,
        /// Load cases, as a load case file (.ohllc, TOML); each names one
        /// of the weather cases.
        load-cases: string,
        /// What was generated, assumed or left out (shown to the user).
        notes: list<string>,
        /// Presets of the clearance windows (none: an empty list).
        clearance-presets: list<clearance-preset>,
    }
}

/// World of design-code plugins (extension point `design-code`).
world code-plugin {
    use code-types.{code-info, generated, clearance-preset, clearance-measure};

    /// Describes the plugin and its parameter file.
    export describe: func() -> code-info;

    /// Weather cases and load cases from a parameter file's text (TOML);
    /// the error says what is wrong with the file.
    export generate: func(parameters: string) -> result<generated, string>;
}

/// Wind factors for structures from a design code (optional for a
/// design-code plugin: one built without it gives none, and OpenOHL keeps
/// its generic drag factor and no shielding). Added in interface version
/// 0.3 without changing anything else: plugins built before load as they
/// are.
interface structure-wind {
    /// The code's wind factors for structures from the user's parameter
    /// file (TOML, as `generate` reads it), as a section library file
    /// (`.ohlsec`, TOML) holding only a `[wind]` table: `source`, `drag`
    /// (a factor per profile shape: `equal_angle`, `circular_hollow`, …),
    /// `face_drag` (a lattice face's drag factor by its solidity ratio)
    /// and `shielding` (the factor on a face behind another by the
    /// solidity ratio of the face in front, and the spacing ratio), each
    /// optional. OpenOHL finds the faces, their solidity and which face is
    /// behind which; the plugin gives only the numbers of its code, from
    /// the parameter file. None: the code gives none. The error says what
    /// is wrong with the parameter file.
    structure-wind: func(parameters: string) -> result<option<string>, string>;
}

/// A design-code plugin that also gives wind factors for structures
/// (extension point `design-code`).
world code-wind-plugin {
    include code-plugin;
    export structure-wind;
}

/// Presets of any clearance rule set — ground, objects (LiDAR classes),
/// crossings, wire to wire — from a design code (optional for a
/// design-code plugin: one built without it gives none). Added in
/// interface version 0.3 without changing anything else: plugins built
/// before load as they are. The presets of the two clearance windows stay
/// in `generated` (`clearance-presets`).
interface rule-presets {
    /// A preset of clearance rules.
    record rule-preset {
        /// Name, unique among the plugin's rule presets (e.g. "ground").
        name: string,
        /// What it holds and where its values come from, in words (the
        /// articles of the code), shown before it is loaded.
        description: string,
        /// The rules, as a clearance rule file (.ohlr, TOML, format
        /// `ohl-clearance-rules`): any targets (`ground`, `points`,
        /// `same_line`, `other_lines`), each distance a distance, a table
        /// by voltage (`{ by_voltage = [[up to kV, distance], …] }`) or a
        /// base plus an amount per kV
        /// (`{ base = …, per_kv = …, above_kv = … }`).
        rules: string,
        /// The weather cases its rules name, as a weather case file
        /// (.ohlwc, TOML); empty when its rules name none (every case).
        weather-cases: string,
    }

    /// The code's rule presets from the user's parameter file (TOML, as
    /// `generate` reads it). `parameters` is empty when the user has
    /// given none: a plugin whose presets come from its own data gives
    /// them anyway, one that needs the file says so in the error. The
    /// error says what is wrong with the parameter file.
    rule-presets: func(parameters: string) -> result<list<rule-preset>, string>;
}

/// A design-code plugin that also gives wind factors for structures and
/// rule presets (extension point `design-code`).
world code-rules-plugin {
    include code-wind-plugin;
    export rule-presets;
}

/// The `rule-presets` export alone: how the host finds it in any
/// design-code plugin (not a world to build plugins for).
world rule-presets-export {
    export rule-presets;
}

/// A check run by a plugin (extension point `check`): OpenOHL measures
/// the line (the conductors, their pairs, stations along them: the
/// geometry), the plugin holds the values and the rules and says what is
/// required at each station. The first such check: the distance between
/// conductors in the span (`phase-distance`).
interface check {
    /// A table of a check's values, shown to the user (and edited by an
    /// admin, cell by cell, through `edit-value`).
    record value-table {
        /// Title.
        title: string,
        /// What it holds, in words.
        note: string,
        /// Column titles.
        columns: list<string>,
        /// Rows of cell texts.
        rows: list<list<string>>,
        /// Which columns may be edited.
        editable: list<bool>,
    }

    /// A choice the user makes before a run (e.g. a diagram).
    record choice {
        /// Title.
        title: string,
        /// What it chooses.
        help: string,
        /// The options.
        options: list<string>,
        /// The option taken unless chosen.
        default: u32,
    }

    /// A check the plugin runs.
    record check-info {
        /// Its id: what OpenOHL measures for it (`phase-distance`).
        id: string,
        /// Title in the Checks menu.
        title: string,
        /// Its submenu of the Checks menu, outer first.
        menu: list<string>,
        /// How the computation is done, shown in the check's window.
        explanation: string,
        /// Its values file (TOML) as shipped: values from the code, read
        /// and edited through `value-tables` / `edit-value`.
        values: string,
        /// Extension of a values file (without the dot).
        values-extension: string,
        /// Choices before a run.
        choices: list<choice>,
        /// Plugin columns (`plugin.name`) the check's window shows per
        /// circuit to be set there.
        circuit-columns: list<string>,
    }

    /// A pair of conductors as OpenOHL measured it (`phase-distance`):
    /// what the rules need besides the stations.
    record conductor-pair {
        /// In one electrical system (or towards an earth wire).
        same-system: bool,
        /// Both hang between the same two structures.
        same-span: bool,
        /// Nominal voltage of each conductor, kV (none: an earth wire).
        kv: tuple<option<f64>, option<f64>>,
        /// Plugin columns' values of each conductor's section
        /// (`plugin.name`, value).
        fields: tuple<list<tuple<string, string>>, list<tuple<string, string>>>,
        /// Mean conductor height of the span, m above sea level.
        altitude: f64,
        /// Diameter of each conductor, mm.
        diameter-mm: tuple<f64, f64>,
        /// Mass of each conductor, kg/m.
        mass-kg-m: tuple<f64, f64>,
        /// Spacers join them in the span: the largest sag of each between
        /// its spacer clamps (and its span's clamps), m.
        spacer-sag: option<tuple<f64, f64>>,
    }

    /// What the plugin requires along a pair.
    record evaluated {
        /// Per station, `per-station` values: the required distance (m)
        /// first, then the check's own (shown with the worst station).
        values: list<f64>,
        /// How many values per station.
        per-station: u32,
        /// The rule applied, in words (e.g. "2.2.1").
        rule: string,
    }

    /// The checks the plugin runs.
    checks: func() -> list<check-info>;

    /// The values of `values` (a values file's text) as tables.
    value-tables: func(check: string, values: string) -> result<list<value-table>, string>;

    /// `values` with cell (`table`, `row`, `column`) set to `text`: the
    /// new file's text, or what is wrong.
    edit-value: func(check: string, values: string, table: u32, row: u32, column: u32, text: string) -> result<string, string>;

    /// What is required at each station of a pair. `stations`: per
    /// station 6 numbers — distance (m), system angle β from the vertical
    /// (°), each conductor's local sag (m), each one's string length l_k
    /// there (m).
    evaluate: func(check: string, values: string, choices: list<u32>, pair: conductor-pair, stations: list<f64>) -> result<evaluated, string>;
}

/// World of check plugins (extension point `check`).
world check-plugin {
    export check;
}

/// A design-code plugin that also runs checks.
world code-check-plugin {
    include code-plugin;
    export check;
}

/// A design-code plugin that also runs checks and gives rule presets.
world code-check-rules-plugin {
    include code-check-plugin;
    export rule-presets;
}

/// The weather a check plugin suggests for one of its checks (optional
/// export, looked for by the host on its own; 2026-10-27): the window of
/// that check ticks the project's weather case matching it when it opens
/// with none chosen (e.g. a code's unequal wind check at 10 °C and 650 Pa).
/// Added to interface version 0.3 without changing anything else: plugins
/// built before load as they are, and suggest none.
interface check-weather {
    /// A weather case to look for among the project's.
    record weather-hint {
        /// Temperature, °C.
        temperature-c: f64,
        /// Wind pressure, Pa.
        wind-pa: f64,
        /// With ice (else none).
        ice: bool,
    }

    /// The weather suggested for check `check` (its id), if any.
    check-weather: func(check: string) -> option<weather-hint>;
}

/// The `check-weather` export alone: how the host finds it in any check
/// plugin (not a world to build plugins for).
world check-weather-export {
    export check-weather;
}

/// Member capacities from a design method (optional export of any
/// plugin, extension point `member-capacity`; 2026-10-27): the structure
/// check sends each member of a solved structure model — its section,
/// material, length, design data and forces — and takes the compression
/// and tension capacities the method gives; OpenOHL computes the usage
/// (force over capacity times the strength factor). The core has a
/// method of its own (ASCE 10-97) and a simple check; a plugin adds
/// others. Added to interface version 0.3 without changing anything
/// else: plugins built before load as they are, and give none.
interface member-capacity {
    /// A method the plugin gives.
    record method-info {
        /// Its name, as the user chooses it (e.g. "my-code-2024").
        name: string,
        /// What it is and where its rules come from, in words.
        description: string,
    }

    /// One member, SI units (m, N, Pa), the forces of one load case.
    record member-input {
        /// Its id.
        id: string,
        /// `truss`, `frame`, `cable` or `tension` (tension only).
        kind: string,
        /// The profile's shape (`equal_angle`, `unequal_angle`,
        /// `circular_hollow`, `general`, …; "" without a profile).
        shape: string,
        /// The profile's dimensions by name (`h`, `b`, `t`, `r`, `d`,
        /// `tw`, `tf`), m.
        dimensions: list<tuple<string, f64>>,
        /// Area, m².
        area: f64,
        /// Second moment about the section's y, m⁴.
        iy: f64,
        /// Second moment about the section's z, m⁴.
        iz: f64,
        /// The minor principal second moment, m⁴.
        iv: f64,
        /// Elastic section modulus about y, m³ (none: not given).
        wy: option<f64>,
        /// Elastic section modulus about z, m³ (none: not given).
        wz: option<f64>,
        /// Young's modulus, Pa.
        e: f64,
        /// Yield strength, Pa (none: not given).
        fy: option<f64>,
        /// Ultimate tensile strength, Pa (none: not given).
        fu: option<f64>,
        /// The member's length, m.
        length: f64,
        /// Its effective length factor `k`.
        k: f64,
        /// Its effective length, m (none: k × length).
        lk: option<f64>,
        /// Its design data as a TOML table (the keys of
        /// `[member.design]`, lengths in m and forces in N as plain
        /// numbers, stresses in Pa; `crossing` the partner's id); "" for
        /// none.
        design: string,
        /// Axial force, N, tension positive.
        axial: f64,
        /// End moments about the local y and z at its first and second
        /// joint: my-i, mz-i, my-j, mz-j, N·m.
        moments: list<f64>,
        /// The crossing partner's axial force in this load case, N (none:
        /// no partner).
        partner-axial: option<f64>,
    }

    /// What the method gives for one member.
    record member-result {
        /// Compression capacity, N (none: the method gives none).
        compression: option<f64>,
        /// What governs it, in words (e.g. "KL/r 85").
        compression-governs: string,
        /// Tension capacity, N (none: the method gives none).
        tension: option<f64>,
        /// What governs it, in words (e.g. "net section").
        tension-governs: string,
        /// Notes for this member (assumptions, limits), in words.
        notes: list<string>,
    }

    /// The methods the plugin gives.
    methods: func() -> list<method-info>;

    /// The capacities of `members` (one result each, in order) by method
    /// `method`, for a load case of strength factor `strength`. The error
    /// says why there are none.
    member-capacities: func(method: string, strength: f64, members: list<member-input>) -> result<list<member-result>, string>;
}

/// A plugin that gives member capacities only (extension point
/// `member-capacity`).
world member-capacity-plugin {
    use types.{plugin-info};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    export member-capacity;
}

/// The `member-capacity` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world member-capacity-export {
    export member-capacity;
}

/// Member checks by a design method (optional export of any plugin,
/// extension point `member-check`; 2026-11-11, owner: "the code check
/// should actually be moved out of the core in plugins that can access
/// the infos they need"): the structure check sends **every checked
/// member of a solved structure in one call** — its class, section,
/// material, lengths, end conditions, design data and its forces in every
/// load case — and takes back, per member, its capacities by name, its
/// usage per load case, what governs with its clause, notes, and what is
/// not on the safe side. A member the plugin returns nothing for is
/// reported by OpenOHL as NOT CHECKED, NOT ON THE SAFE SIDE, never as
/// passing. Unlike `member-capacity` (one load case per call, capacities
/// only) the plugin computes the usage itself, from all the forces.
/// Added to interface version 0.3 without changing anything else:
/// plugins built before load as they are, and give none. SI units
/// throughout (m, N, N·m, Pa). Names of kinds, classes and shapes are the
/// words of OpenOHL's files; a plugin ignores those it does not know and
/// says so in its notes.
interface member-check {
    /// A method the plugin gives.
    record method-info {
        /// Its name, as a structure file chooses it.
        name: string,
        /// What it is and where its rules come from, in words.
        description: string,
    }

    /// A load case of the run.
    record load-case {
        /// Its name.
        name: string,
        /// Its strength factor: OpenOHL's own methods multiply the
        /// capacities by it; the plugin applies it to its usage.
        strength: f64,
        /// Its factor on the members' own weight (already in the forces).
        self-weight: f64,
    }

    /// A member's forces in one load case.
    record case-forces {
        /// The load case: its place in `check-input.cases`.
        load-case: u32,
        /// Axial force, N, tension positive.
        axial: f64,
        /// The forces at its first joint then at its second, in the
        /// member's local axes: fx, fy, fz, mx, my, mz each (12 values).
        end-forces: list<f64>,
        /// The crossing partner's axial force in this case (none: no
        /// partner).
        partner-axial: option<f64>,
        /// A cable or tension-only member gone slack in this case.
        slack: bool,
    }

    /// The member's own bolts (its design data, both ends alike).
    record member-bolts {
        /// The bolt's diameter, m.
        diameter: f64,
        /// The hole's diameter, m.
        hole: option<f64>,
        /// How many bolts.
        count: u32,
        /// Shear planes per bolt.
        shear-planes: u32,
        /// One bolt's shear capacity per plane, N.
        shear-capacity: option<f64>,
        /// The bolt's ultimate strength, Pa.
        ultimate: option<f64>,
        /// Its grade as the files name it ("" not given).
        grade: string,
        /// Holes in one cross-section.
        holes: option<u32>,
    }

    /// The bolts of one end's connection, with the bolt library's values.
    record end-bolts {
        /// The library bolt's id ("" typed at the connection).
        bolt: string,
        /// How many bolts.
        count: u32,
        /// The bolt's diameter, m.
        diameter: option<f64>,
        /// The hole's diameter, m.
        hole: option<f64>,
        /// Shear planes per bolt.
        shear-planes: option<u32>,
        /// One bolt's shear capacity per plane through the threads, N.
        shear-capacity: option<f64>,
        /// The same through the shank, N.
        shear-capacity-shank: option<f64>,
        /// The bolt's ultimate strength, Pa.
        ultimate: option<f64>,
        /// The threads are in the shear plane.
        threads-in-shear: option<bool>,
        /// Its grade as the files name it ("" not given).
        grade: string,
    }

    /// One end's joint detail (a structure file's `[[connection]]`).
    record end-connection {
        /// Which end: 0 at the first joint, 1 at the second.
        end: u32,
        /// `bolted`, `welded`, `pinned`, `fixed`, `continuous` ("" not given).
        kind: string,
        /// What it bolts onto: `member`, `plate`, `splice`, `other` ("" not given).
        onto: string,
        /// The thickness of what it bolts onto, m (a plate's; none: not known).
        onto-thickness: option<f64>,
        /// The leg bolted: `both`, `long`, `short`, `none` ("" not given).
        leg: string,
        /// Its bolts.
        bolts: option<end-bolts>,
        /// Holes in one cross-section.
        holes: option<u32>,
        /// The gauge lines from the heel, m.
        gauges: list<f64>,
        /// From the bolts to the edge of the leg, m.
        edge-distance: option<f64>,
        /// The edge is rolled (not sheared).
        rolled-edge: option<bool>,
        /// From the member's end to the first bolt, m.
        end-distance: option<f64>,
        /// Between bolts along a line, m.
        pitch: option<f64>,
        /// The end moved sideways by this, m (its eccentricity in the model).
        shift: option<f64>,
        /// Shear planes worked out from what it bolts onto.
        planes: option<u32>,
        /// Runs on through the joint as one part with another member.
        continuous: bool,
        /// What OpenOHL says about this end's data.
        notes: list<string>,
    }

    /// One end's conditions as OpenOHL's own check would take them.
    record end-condition {
        /// Eccentric (none: the member's "one end", which one not said).
        eccentric: option<bool>,
        /// Where from: `given`, `design data`, `worked out`, `assumed`.
        eccentric-source: string,
        /// Restrained against turning.
        restrained: option<bool>,
        /// Where from, as `eccentric-source`.
        restrained-source: string,
    }

    /// A part of a built-up member.
    record part {
        /// The part's shape.
        shape: string,
        /// The part's dimensions by name, m.
        dimensions: list<tuple<string, f64>>,
        /// Area, m².
        area: f64,
    }

    /// One checked member with its forces in every load case.
    record member {
        /// The member's id.
        id: string,
        /// `truss`, `frame`, `cable` or `tension`.
        kind: string,
        /// `leg`, `bracing`, `redundant`, `crossing` ("" not given).
        class: string,
        /// The profile's shape (`equal_angle`, …; "" without a profile).
        shape: string,
        /// The profile's dimensions by name, m.
        dimensions: list<tuple<string, f64>>,
        /// The parts of a built-up member (empty: one profile, or its
        /// parts not described).
        parts: list<part>,
        /// Area, m².
        area: f64,
        /// Second moment about the section's y, m⁴.
        iy: f64,
        /// Second moment about the section's z, m⁴.
        iz: f64,
        /// The minor principal second moment, m⁴.
        iv: f64,
        /// Elastic section modulus about y, m³.
        wy: option<f64>,
        /// Elastic section modulus about z, m³.
        wz: option<f64>,
        /// Young's modulus, Pa.
        e: f64,
        /// Yield strength, Pa.
        fy: option<f64>,
        /// Ultimate tensile strength, Pa.
        fu: option<f64>,
        /// System length between its joints, m.
        length: f64,
        /// Effective length factor.
        k: f64,
        /// Effective length, m (none: k × length).
        lk: option<f64>,
        /// Buckling lengths over the system length about the section's
        /// y, z and minor axis (empty: not given; else 3 values).
        length-ratios: list<f64>,
        /// Its crossing partner's id ("" none).
        crossing: string,
        /// The member's own flags: `none`, `one_end`, `both_ends` ("" not given).
        end-eccentricity: string,
        /// The same for the restraint against turning.
        end-restraint: string,
        /// The flat width over thickness ratio given.
        width-thickness: option<f64>,
        /// The thickness of the leg bolted, m.
        thickness: option<f64>,
        /// Plies at the bolts.
        plies: option<u32>,
        /// `both`, `long`, `short`, `none` ("" not given).
        connected-leg: string,
        /// Its bolts.
        bolts: option<member-bolts>,
        /// From the bolts to the edge of the leg, m.
        edge-distance: option<f64>,
        /// From the member's end to the first bolt, m.
        end-distance: option<f64>,
        /// Between bolts along a line, m.
        spacing: option<f64>,
        /// Its two ends' conditions, first joint then second.
        ends: list<end-condition>,
        /// Its ends' joint details: only when the structure is level 4
        /// with its joint details taken (`check-input.joint-details`);
        /// else empty.
        connections: list<end-connection>,
        /// Its forces, one entry per load case.
        forces: list<case-forces>,
    }

    /// Everything of one structure for one call.
    record check-input {
        /// The structure's name.
        structure: string,
        /// The joint details are taken (level 4, the file's option on).
        joint-details: bool,
        /// The load cases of the run.
        cases: list<load-case>,
        /// The checked members.
        members: list<member>,
    }

    /// A capacity by name.
    record capacity {
        /// `tension`, `compression`, or the method's own names.
        name: string,
        /// N (or the unit the name says), a positive number.
        value: f64,
        /// What governs it, in words.
        governs: string,
    }

    /// A member's usage in one load case.
    record case-usage {
        /// Its place in `check-input.cases`.
        load-case: u32,
        /// Share of the capacity used (1 = 100 %), the case's strength
        /// factor applied; not negative.
        usage: f64,
        /// The check that gives it, in words.
        check: string,
    }

    /// What the method gives for one member.
    record member-result {
        /// The member's id.
        id: string,
        /// Its capacities.
        capacities: list<capacity>,
        /// One per load case; a case left out is reported as not checked.
        usages: list<case-usage>,
        /// The governing check with its clause, in words.
        governs: string,
        /// Notes for this member (assumptions, limits), in words.
        notes: list<string>,
        /// What is not on the safe side or not checked for this member,
        /// in words (none: nothing). OpenOHL shows it with the result.
        not-safe: option<string>,
    }

    /// The methods the plugin gives.
    methods: func() -> list<method-info>;

    /// Checks the members of `input` by method `method`: one result per
    /// member it checks, in any order, by id. The error says why there
    /// are none.
    check-members: func(method: string, input: check-input) -> result<list<member-result>, string>;
}

/// A plugin that gives member checks only (extension point
/// `member-check`).
world member-check-plugin {
    use types.{plugin-info};

    /// Describes the plugin.
    export describe: func() -> plugin-info;

    export member-check;
}

/// The `member-check` export alone: how the host finds it in any plugin
/// (not a world to build plugins for).
world member-check-export {
    export member-check;
}

/// Joint checks by a design method (optional export of any plugin beside
/// `member-check`, found by its export name; 2026-11-11): the
/// plates', covers' (splices'), fillet welds' and bolt groups' checks of
/// a structure whose member check is this plugin's method. A separate
/// interface, so that plugins built against `member-check` 0.1.0 load as
/// they are. The structure check sends **every planned part of every
/// joint in one call** — a member's bolt group in a plate or cover with
/// the plate's steel and the distances to its edges, or a weld between
/// two plates — with the force on it in every load case, and takes back
/// per part its usage per case, the governing check with its clause,
/// notes, and what is not on the safe side. A part the plugin returns
/// nothing for is reported by OpenOHL as NOT CHECKED, NOT ON THE SAFE
/// SIDE; so is every part of a structure whose plugin has no such export
/// — never by another code. The method names are `member-check`'s. SI
/// units throughout.
interface joint-check {
    /// A load case of the run.
    record load-case {
        /// Its name.
        name: string,
        /// Its strength factor (the plugin applies it to its usage).
        strength: f64,
    }

    /// A member's bolt group in a plate (or a splice's cover).
    record bolt-group {
        /// How many bolts.
        count: u32,
        /// Their diameter, m.
        diameter: f64,
        /// Their hole, m (none: not given).
        hole: option<f64>,
        /// The bolts' ultimate strength, Pa (none: not given).
        bolt-ultimate: option<f64>,
        /// Gauge lines: the bolts across the force.
        lines: u32,
        /// Bolts along each line (the most on one).
        per-line: u32,
        /// Between bolts along a line, m (none: not known, or one bolt).
        pitch: option<f64>,
        /// Between the outer gauge lines, m (0: one line).
        span: f64,
        /// From the last bolts to the plate's edge along the force with
        /// the member in tension, m (none: the edge not reached).
        end-tension: option<f64>,
        /// The same with the member in compression, m.
        end-compression: option<f64>,
        /// From the outer gauge lines to the plate's edge across the
        /// force, m (the nearer side; none: not known).
        edge: option<f64>,
        /// The plate's width a net section crosses, m, as OpenOHL took it.
        width: f64,
        /// How that width was taken, in words.
        width-note: string,
    }

    /// A plate's thickness and steel.
    record plate-steel {
        /// Thickness, m.
        thickness: f64,
        /// Yield strength, Pa.
        fy: option<f64>,
        /// Ultimate strength, Pa.
        fu: option<f64>,
    }

    /// A weld between two plates.
    record weld {
        /// `fillet` or `full_penetration`.
        kind: string,
        /// A fillet's throat, m (none: not given).
        throat: option<f64>,
        /// Its length, m.
        length: f64,
        /// The length is given (false: the seam's, one side).
        length-given: bool,
        /// The angle between the two plates at the seam, degrees.
        angle: f64,
        /// The lower yield strength of the two plates, Pa.
        fy: option<f64>,
        /// The two plates' thicknesses, m.
        thicknesses: list<f64>,
    }

    /// One part to check.
    record part {
        /// Its number: the result names it.
        id: u32,
        /// The joint.
        joint: string,
        /// The plate (or cover).
        plate: string,
        /// `bolts` (a member's bolt group in the plate) or `weld` (the
        /// plate's weld to another).
        kind: string,
        /// The member whose bolts these are, or the other plate of the weld.
        other: string,
        /// The bolt group (kind `bolts`).
        bolts: option<bolt-group>,
        /// The plate's steel (kind `bolts`).
        steel: option<plate-steel>,
        /// The weld (kind `weld`).
        weld: option<weld>,
        /// The force on the part in each load case, N: the member's axial
        /// force times the share this plate takes (tension positive), or
        /// the resultant the weld carries.
        forces: list<f64>,
        /// What OpenOHL says about this part's data.
        notes: list<string>,
    }

    /// Everything of one structure for one call.
    record joint-input {
        /// The structure's name.
        structure: string,
        /// The load cases of the run.
        cases: list<load-case>,
        /// The parts.
        parts: list<part>,
    }

    /// A part's usage in one load case.
    record case-usage {
        /// Its place in `joint-input.cases`.
        load-case: u32,
        /// Share used (1 = 100 %), the case's strength factor applied.
        usage: f64,
        /// The check that gives it, with its clause, in words.
        check: string,
    }

    /// What the method gives for one part.
    record part-result {
        /// The part's number.
        id: u32,
        /// One per load case; a case left out is reported as not checked.
        usages: list<case-usage>,
        /// The governing check with its clause, in words.
        governs: string,
        /// Notes (assumptions, limits), in words.
        notes: list<string>,
        /// What is not on the safe side or not checked for this part
        /// (none: nothing). OpenOHL shows it with the result.
        not-safe: option<string>,
    }

    /// Checks the parts of `input` by method `method` (a name of the
    /// plugin's `member-check` methods): one result per part it checks.
    check-joints: func(method: string, input: joint-input) -> result<list<part-result>, string>;
}

/// The `joint-check` export alone: how the host finds it in any plugin
/// (not a world to build plugins for).
world joint-check-export {
    export joint-check;
}

/// The joint check with the method's **parameters** (optional export of
/// any plugin beside `joint-check`, found by its export name;
/// 2026-11-18, owner: a plugin's settings reach its joint checks too,
/// not only its member check). The same check as `joint-check`, its
/// records repeated (a separate interface, so that plugins built against
/// `joint-check` load as they are), the input carrying the text of the
/// structure's parameter file for the plugin (TOML; "" none — the
/// method's own values), as `member-check-full` does. A plugin that has
/// it is called by `check-joints-full` instead of `joint-check`'s
/// `check-joints`. SI units throughout.
interface joint-check-full {
    /// A load case of the run.
    record load-case {
        /// Its name.
        name: string,
        /// Its strength factor (the plugin applies it to its usage).
        strength: f64,
    }

    /// A member's bolt group in a plate (or a splice's cover).
    record bolt-group {
        /// How many bolts.
        count: u32,
        /// Their diameter, m.
        diameter: f64,
        /// Their hole, m (none: not given).
        hole: option<f64>,
        /// The bolts' ultimate strength, Pa (none: not given).
        bolt-ultimate: option<f64>,
        /// Gauge lines: the bolts across the force.
        lines: u32,
        /// Bolts along each line (the most on one).
        per-line: u32,
        /// Between bolts along a line, m (none: not known, or one bolt).
        pitch: option<f64>,
        /// Between the outer gauge lines, m (0: one line).
        span: f64,
        /// From the last bolts to the plate's edge along the force with
        /// the member in tension, m (none: the edge not reached).
        end-tension: option<f64>,
        /// The same with the member in compression, m.
        end-compression: option<f64>,
        /// From the outer gauge lines to the plate's edge across the
        /// force, m (the nearer side; none: not known).
        edge: option<f64>,
        /// The plate's width a net section crosses, m, as OpenOHL took it.
        width: f64,
        /// How that width was taken, in words.
        width-note: string,
    }

    /// A plate's thickness and steel.
    record plate-steel {
        /// Thickness, m.
        thickness: f64,
        /// Yield strength, Pa.
        fy: option<f64>,
        /// Ultimate strength, Pa.
        fu: option<f64>,
    }

    /// A weld between two plates.
    record weld {
        /// `fillet` or `full_penetration`.
        kind: string,
        /// A fillet's throat, m (none: not given).
        throat: option<f64>,
        /// Its length, m.
        length: f64,
        /// The length is given (false: the seam's, one side).
        length-given: bool,
        /// The angle between the two plates at the seam, degrees.
        angle: f64,
        /// The lower yield strength of the two plates, Pa.
        fy: option<f64>,
        /// The two plates' thicknesses, m.
        thicknesses: list<f64>,
    }

    /// One part to check.
    record part {
        /// Its number: the result names it.
        id: u32,
        /// The joint.
        joint: string,
        /// The plate (or cover).
        plate: string,
        /// `bolts` (a member's bolt group in the plate) or `weld` (the
        /// plate's weld to another).
        kind: string,
        /// The member whose bolts these are, or the other plate of the weld.
        other: string,
        /// The bolt group (kind `bolts`).
        bolts: option<bolt-group>,
        /// The plate's steel (kind `bolts`).
        steel: option<plate-steel>,
        /// The weld (kind `weld`).
        weld: option<weld>,
        /// The force on the part in each load case, N: the member's axial
        /// force times the share this plate takes (tension positive), or
        /// the resultant the weld carries.
        forces: list<f64>,
        /// What OpenOHL says about this part's data.
        notes: list<string>,
    }

    /// Everything of one structure for one call.
    record joint-input {
        /// The structure's name.
        structure: string,
        /// The plugin's parameter file of the structure (TOML; "" none).
        parameters: string,
        /// The load cases of the run.
        cases: list<load-case>,
        /// The parts.
        parts: list<part>,
    }

    /// A part's usage in one load case.
    record case-usage {
        /// Its place in `joint-input.cases`.
        load-case: u32,
        /// Share used (1 = 100 %), the case's strength factor applied.
        usage: f64,
        /// The check that gives it, with its clause, in words.
        check: string,
    }

    /// What the method gives for one part.
    record part-result {
        /// The part's number.
        id: u32,
        /// One per load case; a case left out is reported as not checked.
        usages: list<case-usage>,
        /// The governing check with its clause, in words.
        governs: string,
        /// Notes (assumptions, limits), in words.
        notes: list<string>,
        /// What is not on the safe side or not checked for this part
        /// (none: nothing). OpenOHL shows it with the result.
        not-safe: option<string>,
    }

    /// Checks the parts of `input` by method `method` (a name of the
    /// plugin's `member-check` methods) with the parameters it carries:
    /// one result per part it checks. The error says why there is no
    /// result (a parameter file it cannot read, a method it does not have).
    check-joints-full: func(method: string, input: joint-input) -> result<list<part-result>, string>;
}

/// The `joint-check-full` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world joint-check-full-export {
    export joint-check-full;
}

/// The joint check with **every force on a part** (optional export of any
/// plugin beside `joint-check-full`, found by its export name;
/// 2026-11-18, the safe-side items of the lattice towers): the records
/// of `joint-check-full` repeated (a separate interface, so that plugins
/// built against it load as they are), each part with, per load case,
/// what acts on it beside its force — a frame member's end shear and
/// moments at its bolt group, the moments of a weld's force about the
/// weld — and a bolt group's plate's free length in compression. A
/// plugin that has it is called by `check-joints-moments` instead of
/// `joint-check-full`; one without it gets `joint-check-full` and
/// OpenOHL says, with each part on which something beside its force
/// acts, that it was not sent (NOT ON THE SAFE SIDE). SI units
/// throughout.
interface joint-check-moments {
    /// A load case of the run.
    record load-case {
        /// Its name.
        name: string,
        /// Its strength factor (the plugin applies it to its usage).
        strength: f64,
    }

    /// A member's bolt group in a plate (or a splice's cover).
    record bolt-group {
        /// How many bolts.
        count: u32,
        /// Their diameter, m.
        diameter: f64,
        /// Their hole, m (none: not given).
        hole: option<f64>,
        /// The bolts' ultimate strength, Pa (none: not given).
        bolt-ultimate: option<f64>,
        /// Gauge lines: the bolts across the force.
        lines: u32,
        /// Bolts along each line (the most on one).
        per-line: u32,
        /// Between bolts along a line, m (none: not known, or one bolt).
        pitch: option<f64>,
        /// Between the outer gauge lines, m (0: one line).
        span: f64,
        /// From the last bolts to the plate's edge along the force with
        /// the member in tension, m (none: the edge not reached).
        end-tension: option<f64>,
        /// The same with the member in compression, m.
        end-compression: option<f64>,
        /// From the outer gauge lines to the plate's edge across the
        /// force, m (the nearer side; none: not known).
        edge: option<f64>,
        /// The plate's width a net section crosses, m, as OpenOHL took it.
        width: f64,
        /// How that width was taken, in words.
        width-note: string,
    }

    /// A plate's thickness and steel.
    record plate-steel {
        /// Thickness, m.
        thickness: f64,
        /// Yield strength, Pa.
        fy: option<f64>,
        /// Ultimate strength, Pa.
        fu: option<f64>,
    }

    /// A weld between two plates.
    record weld {
        /// `fillet` or `full_penetration`.
        kind: string,
        /// A fillet's throat, m (none: not given).
        throat: option<f64>,
        /// Its length, m.
        length: f64,
        /// The length is given (false: the seam's, one side).
        length-given: bool,
        /// The angle between the two plates at the seam, degrees.
        angle: f64,
        /// The lower yield strength of the two plates, Pa.
        fy: option<f64>,
        /// The two plates' thicknesses, m.
        thicknesses: list<f64>,
    }

    /// One part to check.
    record part {
        /// Its number: the result names it.
        id: u32,
        /// The joint.
        joint: string,
        /// The plate (or cover).
        plate: string,
        /// `bolts` (a member's bolt group in the plate) or `weld` (the
        /// plate's weld to another).
        kind: string,
        /// The member whose bolts these are, or the other plate of the weld.
        other: string,
        /// The bolt group (kind `bolts`).
        bolts: option<bolt-group>,
        /// The plate's steel (kind `bolts`).
        steel: option<plate-steel>,
        /// The weld (kind `weld`).
        weld: option<weld>,
        /// The force on the part in each load case, N: the member's axial
        /// force times the share this plate takes (tension positive), or
        /// the resultant the weld carries.
        forces: list<f64>,
        /// What OpenOHL says about this part's data.
        notes: list<string>,
        /// What else acts on the part, per load case as `forces` (empty:
        /// nothing else; see `part-moments`).
        moments: list<part-moments>,
        /// Kind `bolts`: the plate's free length in compression, m — from
        /// the bolts nearest the joint, along the member towards it, to
        /// the nearest bolt of another member within the bolt group's
        /// spread (Whitmore's width), else to the plate's edge (none: not
        /// known).
        free-length: option<f64>,
    }

    /// What acts on a part beside its force in one load case (each a
    /// size, ≥ 0; 2026-11-18).
    record part-moments {
        /// Kind `bolts`: the member's end shear in the plate's plane,
        /// square to the member, N (a frame member's; a truss's 0). Kind
        /// `weld`: 0.
        shear: f64,
        /// Kind `bolts`: the member's moment about the plate's normal at
        /// its bolt group's centroid, N·m. Kind `weld`: the moment of the
        /// force it carries about the weld's middle bending it along its
        /// length (about the axis square to the seam), N·m.
        in-plane: f64,
        /// Kind `bolts`: the member's moment bending the plate out of its
        /// plane (with the member's torsion), N·m. Kind `weld`: the moment
        /// about the seam's own line, N·m.
        out-of-plane: f64,
        /// Kind `bolts`: the member's end force square to the plate (on
        /// its bolts in tension), N. Kind `weld`: 0.
        normal: f64,
    }

    /// Everything of one structure for one call.
    record joint-input {
        /// The structure's name.
        structure: string,
        /// The plugin's parameter file of the structure (TOML; "" none).
        parameters: string,
        /// The load cases of the run.
        cases: list<load-case>,
        /// The parts.
        parts: list<part>,
    }

    /// A part's usage in one load case.
    record case-usage {
        /// Its place in `joint-input.cases`.
        load-case: u32,
        /// Share used (1 = 100 %), the case's strength factor applied.
        usage: f64,
        /// The check that gives it, with its clause, in words.
        check: string,
    }

    /// What the method gives for one part.
    record part-result {
        /// The part's number.
        id: u32,
        /// One per load case; a case left out is reported as not checked.
        usages: list<case-usage>,
        /// The governing check with its clause, in words.
        governs: string,
        /// Notes (assumptions, limits), in words.
        notes: list<string>,
        /// What is not on the safe side or not checked for this part
        /// (none: nothing). OpenOHL shows it with the result.
        not-safe: option<string>,
    }

    /// Checks the parts of `input` by method `method` (a name of the
    /// plugin's `member-check` methods) with the parameters it carries:
    /// one result per part it checks. The error says why there is no
    /// result (a parameter file it cannot read, a method it does not have).
    check-joints-moments: func(method: string, input: joint-input) -> result<list<part-result>, string>;
}

/// The `joint-check-moments` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world joint-check-moments-export {
    export joint-check-moments;
}

/// The bolt groups of a joint under the members' forces together
/// (optional export of any plugin beside `joint-check-moments`, found by
/// its export name; 2026-11-19, stage 4.5 of the joint details: the
/// checks of the joints themselves; added to interface version 0.3
/// without changing anything else). Where several members bolt onto the
/// same part at a joint, OpenOHL gathers each **physical bolt** with the
/// force it carries in every load case — the vector sum of the shares of
/// every member end and plate it holds, the same case's forces only — and
/// sends, per bolt and case, that force's size and the distances from the
/// bolt along it and square to it to each checked ply's edges. Two kinds
/// of group:
///
/// - `holding`: a gusset plate's bolts onto the member holding it (the
///   joint's leg bolted onto the plate): the resultant of the other
///   members' forces on the plate with its moment about the holding bolts'
///   centroid, shared out elastically by OpenOHL; the ply checked is the
///   plate;
/// - `bearing`: every bolt onto one member at the joint (the leg's
///   bearing): the lapped members' shares and the holding bolts' forces on
///   it, summed bolt by bolt; the ply checked is that member.
///
/// No code's rule is in the forces (the elastic sharing is mechanics, its
/// source in the theory page); the plugin applies its code's bolt shear,
/// bearing and end and edge distances to each bolt and gives back per
/// group its usage per case (the most loaded bolt's), the governing check
/// with its clause, notes and what is not on the safe side. A group the
/// plugin returns nothing for, or every group of a plugin without this
/// export, is reported by OpenOHL as NOT CHECKED, NOT ON THE SAFE SIDE —
/// never by another code. SI units throughout.
interface joint-check-groups {
    /// A load case of the run.
    record load-case {
        /// Its name.
        name: string,
        /// Its strength factor (the plugin applies it to its usage).
        strength: f64,
    }

    /// A ply the group's bolts bear on, checked here.
    record ply {
        /// What it is: the member's id, or the plate's.
        part: string,
        /// `member` (an angle's leg: its free edge rolled) or `plate`
        /// (its edges sheared or cut).
        kind: string,
        /// Its thickness, m.
        thickness: f64,
        /// Its yield strength, Pa.
        fy: option<f64>,
        /// Its ultimate strength, Pa.
        fu: option<f64>,
        /// It is a redundant member (the code's smaller end distance).
        redundant: bool,
        /// Its edges' distances are known (false: not known, e.g. where
        /// the member's steel stops is not given — the plugin takes its
        /// code's conservative case, said).
        known: bool,
    }

    /// One physical bolt of a group.
    record group-bolt {
        /// Its diameter, m.
        diameter: f64,
        /// Its hole, m (none: not given).
        hole: option<f64>,
        /// The bolt's ultimate strength, Pa.
        bolt-ultimate: option<f64>,
        /// One bolt's shear capacity per plane through the threads, N
        /// (given: the library's or the member's).
        shear-capacity: option<f64>,
        /// The same through the shank, N.
        shear-capacity-shank: option<f64>,
        /// The threads are in the shear plane (none: not said).
        threads-in-shear: option<bool>,
        /// Its grade as the files name it ("" not given).
        grade: string,
        /// The shear planes its force is taken on (1 where the forces of
        /// several parts meet in it: on the safe side).
        planes: u32,
        /// The member ends and plates whose forces it carries.
        carries: list<string>,
        /// Where it is in the group's plane from the group's centroid, m
        /// (for the plugin's words).
        at: tuple<f64, f64>,
    }

    /// One bolt in one load case.
    record bolt-load {
        /// The size of the force on it in the plies' plane, N.
        force: f64,
        /// Per ply (the order of `group.plies`): from the bolt along the
        /// direction it pushes that ply to the ply's edge, m; none: no
        /// edge that way (the part runs on).
        ends: list<option<f64>>,
        /// Per ply: from the bolt square to that direction to the nearer
        /// edge, m; none: no edge either way.
        sides: list<option<f64>>,
        /// Per ply: from the bolt's centre to the centre of the next hole
        /// in that ply along the same direction (a hole within a bolt
        /// diameter of its line), m; none: no hole ahead.
        ahead: list<option<f64>>,
    }

    /// One group to check.
    record group {
        /// Its number: the result names it.
        id: u32,
        /// The joint.
        joint: string,
        /// `holding` or `bearing` (above).
        kind: string,
        /// The plate (holding) or the member (bearing) whose bolts these
        /// are.
        part: string,
        /// The plies checked (every bolt of the group bears on each).
        plies: list<ply>,
        /// Its bolts.
        bolts: list<group-bolt>,
        /// Per load case, per bolt (the order of `bolts`).
        loads: list<list<bolt-load>>,
        /// What OpenOHL says about this group's data and forces.
        notes: list<string>,
    }

    /// Everything of one structure for one call.
    record group-input {
        /// The structure's name.
        structure: string,
        /// The plugin's parameter file of the structure (TOML; "" none).
        parameters: string,
        /// The load cases of the run.
        cases: list<load-case>,
        /// The groups.
        groups: list<group>,
    }

    /// A group's usage in one load case.
    record case-usage {
        /// Its place in `group-input.cases`.
        load-case: u32,
        /// Share used by the most loaded bolt (1 = 100 %), the case's
        /// strength factor applied.
        usage: f64,
        /// The check that gives it, with its clause and the bolt, in words.
        check: string,
    }

    /// What the method gives for one group.
    record group-result {
        /// The group's number.
        id: u32,
        /// One per load case; a case left out is reported as not checked.
        usages: list<case-usage>,
        /// The governing check with its clause, in words.
        governs: string,
        /// Notes (assumptions, limits), in words.
        notes: list<string>,
        /// What is not on the safe side or not checked for this group
        /// (none: nothing). OpenOHL shows it with the result.
        not-safe: option<string>,
    }

    /// Checks the groups of `input` by method `method` (a name of the
    /// plugin's `member-check` methods) with the parameters it carries:
    /// one result per group it checks. The error says why there is no
    /// result (a parameter file it cannot read, a method it does not have).
    check-joint-groups: func(method: string, input: group-input) -> result<list<group-result>, string>;
}

/// The `joint-check-groups` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world joint-check-groups-export {
    export joint-check-groups;
}

/// The bolts of a joint's groups in tension, with prying (optional export
/// of any plugin beside `joint-check-groups`, found by its export name;
/// 2026-11-19, stage 4.5 of the joint details; added to interface version
/// 0.3 without changing anything else). OpenOHL sends the groups of
/// `joint-check-groups` and, per group, each bolt's tension in every load
/// case — the forces square to the plies and the moments bending them out
/// of their plane, shared by the bolts elastically about their centroid
/// (no contact between the plies taken; which side each ply lies on not
/// used: each bolt's share taken as pulling) — with the flanges each bolt
/// bends as it pulls (a T-stub's flange: its edge and its web's face from
/// the bolt, its length along the bolts the bolt takes). The plugin checks
/// each bolt in tension and in shear and tension together by its code,
/// the prying force on it from the flanges, and each flange's bending;
/// one call gives back per group what `check-joint-groups` gives, the
/// checks in tension among them. A plugin without this export is called by
/// `check-joint-groups`, and OpenOHL says that the bolts in tension are not
/// checked (NOT ON THE SAFE SIDE). SI units throughout.
interface joint-check-groups-tension {
    use joint-check-groups.{group-input, group-result};

    /// A flange a bolt in tension bends (the flange of a T-stub: the
    /// prying model of Struik and de Back, theory page joint-groups).
    record tee {
        /// The member or plate it is a flange of.
        part: string,
        /// Its thickness, m.
        thickness: f64,
        /// Its yield strength, Pa (none: not given).
        fy: option<f64>,
        /// From the bolt's centre to the flange's free edge (an angle's
        /// toe) across the bolts' line, m: `a` of the model.
        edge: f64,
        /// From the bolt's centre to the face of the web stiffening the
        /// flange (an angle's other leg), m: `b` of the model.
        web: f64,
        /// The flange's length along the bolts' line this bolt takes, m
        /// (`w` of the model): to the middle between it and the next bolt
        /// each way, at most to the flange's end and to its distance from
        /// the web.
        width: f64,
    }

    /// One bolt of a group (the order of `group.bolts`).
    record bolt-tension {
        /// The bolt's tension capacity as its library gives it (its
        /// ultimate tensile load), N (none: not given).
        tension-capacity: option<f64>,
        /// The flanges it bends as it pulls.
        tees: list<tee>,
        /// The plies it pulls whose bending is not known (a plate, a
        /// flange not found), in words: their prying not worked out.
        unknown: list<string>,
    }

    /// The tensions of one group of `group-input.groups`.
    record group-tension {
        /// The group's number.
        id: u32,
        /// Its bolts (the order of `group.bolts`).
        bolts: list<bolt-tension>,
        /// Per load case, per bolt: the tension pulling it, N (0: none).
        loads: list<list<f64>>,
    }

    /// Checks the groups of `input` by method `method` as
    /// `check-joint-groups` does, each bolt also in tension with `tension`
    /// (one per group of `input` that has bolts in tension; a group
    /// without one: in shear as before).
    check-joint-groups-tension: func(method: string, input: group-input, tension: list<group-tension>) -> result<list<group-result>, string>;
}

/// The `joint-check-groups-tension` export with the `joint-check-groups`
/// one whose records it takes: how the host finds them in any plugin (not
/// a world to build plugins for).
world joint-check-groups-tension-export {
    export joint-check-groups;
    export joint-check-groups-tension;
}

/// The bolts of a joint's groups in tension with the prying of the plates
/// they pull too (optional export of any plugin beside
/// `joint-check-groups-tension`, found by its export name; 2026-11-19, the
/// owner's decision of that day: a gusset plate's own prying and bending
/// under bolts in tension by the same T-stub model as an angle's flange;
/// added to interface version 0.3 without changing anything else). The
/// same call as `check-joint-groups-tension`, each bolt with the plates it
/// bends besides the flanges: a plate is a flange **without a web** — the
/// pull reaches it through the bolts of the members on it, which hold it
/// against no turning — so the model's moment at the web is taken as none
/// and the whole moment of the pull is at the bolt line (Struik and de
/// Back's Eq. 17.8 with no moment at the web): the prying Q = T b'/a' (B =
/// T (1 + b'/a'), the largest the model gives) and the plate's bending T b'
/// <= delta w t^2 f_y / 4 (delta = 1 - d0/w), with a' = a + d/2, b' = b -
/// d/2, a <= 1.25 b as for a flange. A plugin without this export is called
/// by `check-joint-groups-tension`, and OpenOHL says the plates' prying is
/// not worked out (NOT ON THE SAFE SIDE). SI units throughout.
interface joint-check-groups-prying {
    use joint-check-groups.{group-input, group-result};
    use joint-check-groups-tension.{tee};

    /// One bolt of a group (the order of `group.bolts`).
    record bolt-prying {
        /// The bolt's tension capacity as its library gives it (its
        /// ultimate tensile load, F_u A_s), N (none: not given).
        tension-capacity: option<f64>,
        /// The flanges with a web it bends as it pulls (as
        /// `bolt-tension.tees`).
        tees: list<tee>,
        /// The plates it bends as it pulls: flanges without a web (`edge`
        /// from the bolt to the plate's edge where it bears on the part
        /// under it, away from where the pull comes in: `a`; `web` from
        /// the bolt to the farthest bolt of a member pulling it: `b`;
        /// `width` its length along the bolts' line the bolt takes: `w`).
        plates: list<tee>,
        /// The plies it pulls whose bending is not known, in words: their
        /// prying not worked out.
        unknown: list<string>,
    }

    /// The tensions of one group of `group-input.groups`.
    record group-prying {
        /// The group's number.
        id: u32,
        /// Its bolts (the order of `group.bolts`).
        bolts: list<bolt-prying>,
        /// Per load case, per bolt: the tension pulling it, N (0: none).
        loads: list<list<f64>>,
    }

    /// Checks the groups of `input` by method `method` as
    /// `check-joint-groups-tension` does, the plates each bolt bends
    /// with their prying and bending too.
    check-joint-groups-prying: func(method: string, input: group-input, tension: list<group-prying>) -> result<list<group-result>, string>;
}

/// The `joint-check-groups-prying` export with the exports whose records
/// it takes: how the host finds them in any plugin (not a world to build
/// plugins for).
world joint-check-groups-prying-export {
    export joint-check-groups;
    export joint-check-groups-tension;
    export joint-check-groups-prying;
    /// A bent plate's bend (2026-11-19): it takes `joint-check-groups`'
    /// records too; looked up on its own as the others.
    export joint-check-bends;
}

/// A bent plate's bend in bending (optional export of any plugin, found by
/// its export name; 2026-11-19, the owner's decision of that day: a check
/// of the bend of a plate folded along a line — the joint layout's bent
/// plate — in the code plugins; added to interface version 0.3 without
/// changing anything else). OpenOHL works out, per bend and load case, the
/// forces on the plate's section along its bend line (its width the bend's
/// length, its depth the plate's thickness) from the members' forces on the
/// flat in their plane — no code's rule in them, conservative: the force
/// across the bend, the shear along it, the moment about it (each member's
/// force across the bend times its line's distance out of the flat's middle
/// plane, by size, plus the force across the bend turned by the bend's
/// angle times the lever to the farthest bolt holding the other flat on the
/// leg) and the moment in the plate's plane about the section's middle.
/// The plugin applies its code's rules to that section. A plugin without
/// this export: OpenOHL says the bend's own bending is not checked, NOT ON
/// THE SAFE SIDE, as before. SI units throughout.
interface joint-check-bends {
    use joint-check-groups.{load-case, group-result};

    /// What acts on a bend's section in one load case (sizes and signs as
    /// said).
    record bend-load {
        /// Across the bend in the flat's plane, N (tension positive).
        axial: f64,
        /// Along the bend line in the plate's plane, N (size).
        shear: f64,
        /// About the bend line, bending the plate across its thickness,
        /// N m (size).
        moment: f64,
        /// In the plate's plane about the section's middle, N m (size).
        moment-in-plane: f64,
    }

    /// One bend.
    record bend {
        /// Its number: the result names it.
        id: u32,
        /// The joint.
        joint: string,
        /// The bent plate's two flats, in words ("P1/P2").
        part: string,
        /// The plate's thickness, m.
        thickness: f64,
        /// Its yield strength, Pa (none: not known).
        fy: option<f64>,
        /// Its ultimate strength, Pa (none: not known).
        fu: option<f64>,
        /// The bend's length along its line: the section's width, m.
        width: f64,
        /// Its inside radius, m.
        inner-radius: f64,
        /// The angle the plate turns through at it, rad.
        angle: f64,
        /// A weld on either flat (where, not known: it may be within the
        /// bend's zone).
        welded: bool,
        /// Per load case (the order of `bend-input.cases`).
        loads: list<bend-load>,
        /// What OpenOHL says about this bend's data and forces.
        notes: list<string>,
    }

    /// Everything of one structure for one call.
    record bend-input {
        /// The structure's name.
        structure: string,
        /// The plugin's parameter file of the structure (TOML; "" none).
        parameters: string,
        /// The load cases of the run.
        cases: list<load-case>,
        /// The bends.
        bends: list<bend>,
    }

    /// Checks the bends of `input` by method `method` (a name of the
    /// plugin's `member-check` methods): one result per bend (its id), a
    /// usage per load case with the check and clause that give it.
    check-bends: func(method: string, input: bend-input) -> result<list<group-result>, string>;
}


/// Minimum bolt distances by a design method (optional export of any
/// plugin beside `member-check`, found by its export name;
/// 2026-11-11): what OpenOHL's bolt tools place and check bolts by when
/// a structure's member check is this plugin's method. Without it the
/// tools say that the plugin gives no minimum distances — never another
/// code's. SI units.
interface bolt-distances {
    /// One bolt in one connected part.
    record distance-input {
        /// The bolt's diameter, m.
        diameter: f64,
        /// The connected part's thickness, m (0: not known).
        thickness: f64,
        /// The connected part's ultimate strength, Pa (none: not known).
        ultimate: option<f64>,
        /// The force one bolt transmits, N (none: not known).
        bolt-force: option<f64>,
        /// The part's edge is sheared (false: rolled).
        sheared-edge: bool,
        /// The member is a redundant.
        redundant: bool,
    }

    /// The minimums, m.
    record distances {
        /// From where the steel stops to a bolt, along the force.
        end: f64,
        /// Between two bolts.
        spacing: f64,
        /// From a bolt to the free edge across the force.
        edge: f64,
        /// The hole's diameter (none: the method gives none).
        hole: option<f64>,
        /// The clause of each: end, spacing, edge (3 entries).
        clauses: list<string>,
        /// Notes, in words.
        notes: list<string>,
    }

    /// The minimum distances by method `method` (none: the method has
    /// none for this bolt). The error says why.
    minimum-distances: func(method: string, input: distance-input) -> result<option<distances>, string>;
}

/// The `bolt-distances` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world bolt-distances-export {
    export bolt-distances;
}

/// The minimum bolt distances with the end's bolts and the method's
/// **parameters** (optional export of any plugin beside `bolt-distances`,
/// found by its export name; 2026-11-18, third round, owner: "1 yes go
/// ahead"): without an analysis the plugin works out the force one bolt
/// transmits itself — its own design shear capacity of the bolt, from
/// the bolts' data sent here — instead of the host sending one. A
/// separate interface with its own records, so that plugins built
/// against `bolt-distances` load as they are: a plugin that has it is
/// called by `minimum-distances-full` instead of `bolt-distances`'
/// `minimum-distances`. SI units.
interface bolt-distances-full {
    /// The bolts of the member end, as OpenOHL merges them (the end's
    /// connection over the member's design data, the bolt library's
    /// values).
    record bolts {
        /// How many bolts.
        count: u32,
        /// Shear planes per bolt.
        shear-planes: u32,
        /// One bolt's shear capacity per plane through the threads, N
        /// (given: the library's or the member's).
        shear-capacity: option<f64>,
        /// The same through the shank, N.
        shear-capacity-shank: option<f64>,
        /// The bolt's ultimate strength, Pa.
        ultimate: option<f64>,
        /// The threads are in the shear plane (none: not said).
        threads-in-shear: option<bool>,
        /// Its grade as the files name it ("" not given).
        grade: string,
    }

    /// One bolt in one connected part.
    record distance-input {
        /// The bolt's diameter, m.
        diameter: f64,
        /// The connected part's thickness, m (0: not known).
        thickness: f64,
        /// The connected part's ultimate strength, Pa (none: not known).
        ultimate: option<f64>,
        /// The force one bolt transmits by the last analysis, N (none: no
        /// analysis — the plugin takes its own, e.g. the bolt's design
        /// shear capacity, or leaves the force terms out).
        analysis-force: option<f64>,
        /// The end's bolts (none: only their diameter is known).
        bolts: option<bolts>,
        /// The part's edge is sheared (false: rolled).
        sheared-edge: bool,
        /// The member is a redundant.
        redundant: bool,
        /// The text of the structure's parameter file for the plugin
        /// (TOML; "" none: the method's own values), as `member-check-full`
        /// and `joint-check-full` get it.
        parameters: string,
    }

    /// The minimums, m, and the force they took.
    record distances {
        /// From where the steel stops to a bolt, along the force.
        end: f64,
        /// Between two bolts.
        spacing: f64,
        /// From a bolt to the free edge across the force.
        edge: f64,
        /// The hole's diameter (none: the method gives none).
        hole: option<f64>,
        /// The clause of each: end, spacing, edge (3 entries).
        clauses: list<string>,
        /// Notes, in words.
        notes: list<string>,
        /// The force per bolt the minimums took, N: the analysis' when
        /// sent, else the plugin's own (none: none taken — the force terms
        /// left out, or the method's minimums take no force).
        bolt-force: option<f64>,
        /// Where the plugin's own force comes from, in words ("the bolt's
        /// design shear capacity, ASCE 10-97 4.3.2"; "" the analysis' or
        /// none).
        force-basis: string,
    }

    /// The minimum distances by method `method` (none: the method has
    /// none for this bolt). The error says why.
    minimum-distances-full: func(method: string, input: distance-input) -> result<option<distances>, string>;
}

/// The `bolt-distances-full` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world bolt-distances-full-export {
    export bolt-distances-full;
}

/// The member check with everything of the structure that OpenOHL's own
/// methods read (optional export of any plugin beside `member-check`,
/// found by its export name; 2026-11-18, owner: "yes go ahead with your
/// recommendations" — the design codes move out of the core into plugins
/// behind it). A separate interface with its own records, so that plugins
/// built against `member-check` load as they are: a plugin that has it is
/// called by `check-members-full` instead of `member-check`'s
/// `check-members`; its methods are still `member-check`'s `methods`.
///
/// Beside what `member-check` sends it carries what the core's own checks
/// read: the section's other values and the profile's properties as
/// OpenOHL works them out, the capacities given on the member, the ends'
/// joints and what they bolt onto, and per load case the loads along the
/// member, whether it bowed or was kept active, and the member a redundant
/// member braces. And the method's **parameters**: the text of the
/// structure's parameter file for the plugin (TOML; "" none — the
/// method's own values, said in its note), as a design-code plugin is
/// given its parameter file (`parameters-template` gives the template).
///
/// What comes back may leave a member's usage in a case empty (no
/// capacity: its check says why) and may be infinite or not a number
/// (failing: OpenOHL never takes it as a pass), as OpenOHL's own methods
/// report. A member it returns nothing for is NOT CHECKED, NOT ON THE
/// SAFE SIDE. SI units throughout (m, N, N·m, Pa).
interface member-check-full {
    /// A load case of the run.
    record load-case {
        /// Its name.
        name: string,
        /// Its strength factor (the plugin applies it to its usage).
        strength: f64,
        /// Its factor on the members' own weight (already in the forces).
        self-weight: f64,
    }

    /// A profile's cross-section properties as OpenOHL works them out
    /// (the section library's values given replacing the computed ones).
    /// Axes as the library's: y along the width, z along the height, u
    /// and v the principal axes; positions from the lower left of the
    /// outline's box.
    record profile-properties {
        /// Area, m².
        area: f64,
        /// The centroid, m.
        centroid: tuple<f64, f64>,
        /// Second moment about y, m⁴.
        iy: f64,
        /// Second moment about z, m⁴.
        iz: f64,
        /// The product of inertia about the centroid, m⁴.
        iyz: f64,
        /// Second moment about the major principal axis u, m⁴.
        iu: f64,
        /// Second moment about the minor principal axis v, m⁴.
        iv: f64,
        /// The angle of u from y, radians.
        principal-angle: f64,
        /// Torsion constant, m⁴.
        it: option<f64>,
        /// The shear centre, m.
        shear-centre: option<tuple<f64, f64>>,
        /// Warping constant, m⁶.
        warping: option<f64>,
        /// Elastic modulus about y, m³.
        wel-y: option<f64>,
        /// Elastic modulus about z, m³.
        wel-z: option<f64>,
        /// Elastic modulus about u, m³.
        wel-u: option<f64>,
        /// Elastic modulus about v, m³.
        wel-v: option<f64>,
        /// Plastic modulus about y, m³.
        wpl-y: option<f64>,
        /// Plastic modulus about z, m³.
        wpl-z: option<f64>,
    }

    /// A member's section.
    record section {
        /// Its id.
        id: string,
        /// The library profile's shape (`equal_angle`, …; "" none).
        shape: string,
        /// The profile's dimensions by name, m.
        dimensions: list<tuple<string, f64>>,
        /// The values the section library gives for the profile, by the
        /// library's names (`area`, `iy`, …, SI): a profile changed by a
        /// method (an effective section) keeps them, as the library does.
        given: list<tuple<string, f64>>,
        /// The profile's properties (none: no library profile).
        properties: option<profile-properties>,
        /// Area, m².
        area: f64,
        /// Second moments about y and z, m⁴.
        iy: f64,
        /// See `iy`.
        iz: f64,
        /// The minor principal second moment, m⁴.
        iv: f64,
        /// Torsion constant as the model takes it, m⁴.
        j: f64,
        /// Elastic moduli about y and z, m³.
        wy: option<f64>,
        /// See `wy`.
        wz: option<f64>,
        /// Young's and shear moduli, Pa.
        e: f64,
        /// See `e`.
        g: f64,
        /// Yield and ultimate strengths, Pa.
        fy: option<f64>,
        /// See `fy`.
        fu: option<f64>,
        /// Allowable tension and compression given on the section, N.
        tension: option<f64>,
        /// See `tension`.
        compression: option<f64>,
        /// Allowable moments about y and z given on the section, N·m.
        moment-y: option<f64>,
        /// See `moment-y`.
        moment-z: option<f64>,
    }

    /// A member's own bolts (its design data, both ends alike).
    record member-bolts {
        /// The bolt's diameter, m.
        diameter: f64,
        /// The hole's diameter, m.
        hole: option<f64>,
        /// How many bolts.
        count: u32,
        /// Shear planes per bolt.
        shear-planes: u32,
        /// One bolt's shear capacity per plane, N.
        shear-capacity: option<f64>,
        /// The bolt's ultimate strength, Pa.
        ultimate: option<f64>,
        /// Its grade as the files name it ("" not given).
        grade: string,
        /// Holes in one cross-section.
        holes: option<u32>,
    }

    /// The bolts of one end's connection, with the bolt library's values.
    record end-bolts {
        /// The library bolt's id ("" typed at the connection).
        bolt: string,
        /// How many bolts.
        count: u32,
        /// The bolt's diameter, m.
        diameter: option<f64>,
        /// The hole's diameter, m.
        hole: option<f64>,
        /// Shear planes per bolt.
        shear-planes: option<u32>,
        /// One bolt's shear capacity per plane through the threads, N.
        shear-capacity: option<f64>,
        /// The same through the shank, N.
        shear-capacity-shank: option<f64>,
        /// The bolt's ultimate strength, Pa.
        ultimate: option<f64>,
        /// The threads are in the shear plane.
        threads-in-shear: option<bool>,
        /// Its grade as the files name it ("" not given).
        grade: string,
    }

    /// The leg a member's end bolts onto (another member's, lapped).
    record onto-leg {
        /// That member's id.
        member: string,
        /// Its leg's thickness, m.
        thickness: f64,
        /// Its steel's ultimate strength, Pa.
        fu: option<f64>,
    }

    /// One end's joint detail (a structure file's `[[connection]]`).
    record end-connection {
        /// `bolted`, `welded`, `pinned`, `fixed`, `continuous` ("" not given).
        kind: string,
        /// What it bolts onto: `member`, `plate`, `splice`, `other` ("" not given).
        onto: string,
        /// The thickness of what it bolts onto, m (a plate's; none: not known).
        onto-thickness: option<f64>,
        /// The leg bolted: `both`, `long`, `short`, `none` ("" not given).
        leg: string,
        /// Its bolts.
        bolts: option<end-bolts>,
        /// Holes in one cross-section.
        holes: option<u32>,
        /// The gauge lines from the heel, m.
        gauges: list<f64>,
        /// From the bolts to the edge of the leg, m.
        edge-distance: option<f64>,
        /// The edge is rolled (not sheared).
        rolled-edge: option<bool>,
        /// From the member's end to the first bolt, m.
        end-distance: option<f64>,
        /// Between bolts along a line, m.
        pitch: option<f64>,
        /// The end moved sideways by this, m.
        shift: option<f64>,
        /// Shear planes worked out from what it bolts onto.
        planes: option<u32>,
        /// Why they were worked out so.
        planes-why: string,
        /// Runs on through the joint as one part with another member.
        continuous: bool,
        /// The leg it bolts onto (only bolting onto a member whose
        /// thickness is known; none at a continuous end).
        onto-leg: option<onto-leg>,
        /// What OpenOHL says about this end's data.
        notes: list<string>,
    }

    /// One condition at one end, as OpenOHL works it out.
    record condition {
        /// Its value (none: the member's "one end", which one not said).
        value: option<bool>,
        /// Where from: `given`, `design data`, `worked out`, `assumed`.
        source: string,
        /// Why, when worked out ("" none).
        why: string,
    }

    /// One end of a member.
    record member-end {
        /// The joint there.
        joint: string,
        /// Connected eccentrically.
        eccentric: condition,
        /// Restrained against turning.
        restrained: condition,
        /// Its joint detail: only when the structure is level 4 with its
        /// joint details taken (`full-input.joint-details`); else none.
        connection: option<end-connection>,
    }

    /// The member a redundant member braces (`[analysis]
    /// redundant_force`) in one load case.
    record braced {
        /// The braced member's piece whose compression gives the force.
        member: string,
        /// The joint where the redundant member braces it.
        joint: string,
        /// The compression in it, N (0: in tension).
        force: f64,
        /// The braced member is itself a redundant member (its design
        /// force).
        via-redundant: bool,
    }

    /// A member's forces in one load case.
    record case-forces {
        /// The load case: its place in `full-input.cases`.
        load-case: u32,
        /// Axial force, N, tension positive.
        axial: f64,
        /// The forces at its first joint then at its second, in the
        /// member's local axes: fx, fy, fz, mx, my, mz each (12 values).
        end-forces: list<f64>,
        /// The crossing partner's axial force (none: no partner).
        partner-axial: option<f64>,
        /// A cable or tension-only member gone slack.
        slack: bool,
        /// A tension-only member shortened beyond its buckling load: it
        /// carries that load and no more.
        bowed: bool,
        /// A tension-only member kept active because the active set did
        /// not settle (approximate).
        kept-active: bool,
        /// The member's length in the solve, m.
        length: f64,
        /// The load along it the end forces include (its self-weight as
        /// a frame), N/m, local x, y, z.
        span-load: list<f64>,
        /// The load along it put on its joints as halves (member wind,
        /// ice, a truss's self-weight), N/m, local x, y, z.
        lumped-load: list<f64>,
        /// A redundant member with the redundant-force check on: the
        /// member it braces (none: not found, `braced-why` says why).
        braced: option<braced>,
        /// Why the braced member was not found ("" found, or not a
        /// redundant member, or the check off).
        braced-why: string,
    }

    /// One member with its forces in every load case.
    record member {
        /// The member's id.
        id: string,
        /// `truss`, `frame`, `cable` or `tension`.
        kind: string,
        /// Checked as a frame (its moments), else axially.
        frame: bool,
        /// `leg`, `bracing`, `redundant`, `crossing` ("" not given).
        class: string,
        /// Its section.
        section: section,
        /// System length between its joints, m.
        length: f64,
        /// Effective length factor.
        k: f64,
        /// Effective length, m (none: k × length).
        lk: option<f64>,
        /// Buckling lengths over the system length about the section's
        /// y, z and minor axis (empty: not given; else 3 values).
        length-ratios: list<f64>,
        /// Its crossing partner's id ("" none).
        crossing: string,
        /// The member's own flags: `none`, `one_end`, `both_ends` ("" not given).
        end-eccentricity: string,
        /// The same for the restraint against turning.
        end-restraint: string,
        /// The flat width over thickness ratio given.
        width-thickness: option<f64>,
        /// The thickness of the leg bolted, m.
        thickness: option<f64>,
        /// Plies at the bolts.
        plies: option<u32>,
        /// `both`, `long`, `short`, `none` ("" not given).
        connected-leg: string,
        /// Its bolts.
        bolts: option<member-bolts>,
        /// From the bolts to the edge of the leg, m.
        edge-distance: option<f64>,
        /// From the member's end to the first bolt, m.
        end-distance: option<f64>,
        /// Between bolts along a line, m.
        spacing: option<f64>,
        /// The member's tension capacity given (`capacity_tension`), N.
        capacity-tension: option<f64>,
        /// The member's compression capacity given, N.
        capacity-compression: option<f64>,
        /// Its two ends, first joint then second.
        ends: list<member-end>,
        /// Its forces, one entry per load case.
        forces: list<case-forces>,
    }

    /// Everything of one structure for one call.
    record full-input {
        /// The structure's name.
        structure: string,
        /// The plugin's parameter file of the structure (TOML; "" none).
        parameters: string,
        /// The joint details are taken (level 4, the file's option on).
        joint-details: bool,
        /// `[analysis] single_angle_moments`: a single angle's (and a
        /// lattice member's) end moments added to its check.
        single-angle-moments: bool,
        /// `[analysis] tension_compression`: `buckling` or `none`.
        tension-compression: string,
        /// `[analysis] redundant_force` as a share (0.025: 2.5 %; none:
        /// the check off).
        redundant-share: option<f64>,
        /// The load cases of the run (none: the capacities only).
        cases: list<load-case>,
        /// The checked members.
        members: list<member>,
    }

    /// A capacity by name.
    record capacity {
        /// `tension`, `compression`, or the method's own names.
        name: string,
        /// N (or the unit the name says), a positive number.
        value: f64,
        /// What governs it, in words.
        governs: string,
    }

    /// A member's result in one load case.
    record case-result {
        /// Its place in `full-input.cases`.
        load-case: u32,
        /// Share of the capacity used (1 = 100 %), the case's strength
        /// factor applied; none: no capacity (the check says why);
        /// infinite or not a number: failing.
        usage: option<f64>,
        /// What governs, with its clause, in words.
        check: string,
    }

    /// What the method gives for one member.
    record member-result {
        /// The member's id.
        id: string,
        /// Its capacities by name.
        capacities: list<capacity>,
        /// One per load case; a case left out is reported as not checked.
        cases: list<case-result>,
        /// The governing check (no load case: its capacities), in words.
        governs: string,
        /// Notes for this member (assumptions, limits), in words.
        notes: list<string>,
        /// What is not on the safe side or not checked for this member
        /// (none: nothing). When a case's `check` does not already say it
        /// (`[not on the safe side: …]`), OpenOHL adds it.
        not-safe: option<string>,
    }

    /// What one call gives.
    record full-output {
        /// The method in words for the run's notes ("SIA 263:2013, design
        /// values with γ_M1 1.05, γ_M2 1.25"), with the parameters used.
        method-note: string,
        /// One result per member it checks, in any order, by id.
        results: list<member-result>,
    }

    /// The parameter file of method `method` as a template: TOML with its
    /// schema in comments and the method's own values (none: the method
    /// takes no parameters).
    parameters-template: func(method: string) -> option<string>;

    /// Checks the members of `input` by method `method`. No load case:
    /// the capacities only (`member-result.cases` empty). The error says
    /// why there is no result (a parameter file it cannot read, a method
    /// it does not have).
    check-members-full: func(method: string, input: full-input) -> result<full-output, string>;
}

/// The `member-check-full` export alone: how the host finds it in any
/// plugin (not a world to build plugins for).
world member-check-full-export {
    export member-check-full;
}

/// Member checks with **what braces each member** (2026-11-19, stage 4.3
/// of the joint details; added to interface version 0.3 without changing
/// anything else: a plugin without it is called by `member-check-full` as
/// before). The same records and results as `member-check-full`, and per
/// member the geometry its buckling lengths are worked out from — no
/// code's rule: the run of members in line it belongs to and the bracing
/// points along that run, each with the members holding it and the
/// direction each holds it in. The plugin applies its code's rules (which
/// point holds which axis, a crossing's other diagonal by its force in
/// the case, a bracing member strong enough). A member's own `k`, `lk` or
/// `length-ratios` given still win (the plugin says which it took).
interface member-check-bracing {
    use member-check-full.{full-input, full-output};

    /// A member holding a bracing point, or a support fixed along one
    /// axis.
    record restraint {
        /// Its id (a member of `full-input.members`, design-checked; ""
        /// a support fixed along `direction`).
        member: string,
        /// Its direction from the point square to the run, in the braced
        /// member's local y and z (a unit vector).
        direction: tuple<f64, f64>,
        /// It passes through the point (a crossing: in line on both sides,
        /// or a crossing partner away from a joint).
        through: bool,
    }

    /// A bracing point along a run: each of its joints (its two ends
    /// included) and each crossing away from a joint.
    record bracing-point {
        /// From the run's start, m.
        at: f64,
        /// The joint there ("" a crossing away from a joint).
        joint: string,
        /// A support fixed in all three translations (held in every
        /// direction).
        support: bool,
        /// The members holding it (none: nothing holds it).
        restraints: list<restraint>,
    }

    /// A member of a run and where it lies along it.
    record run-piece {
        /// Its id.
        member: string,
        /// From the run's start to its first end along the run, m.
        start: f64,
        /// To its other end, m.
        end: f64,
        /// Its first joint (`ends[0]`) is at `start`.
        forward: bool,
    }

    /// What braces one member.
    record member-bracing {
        /// The member's id.
        member: string,
        /// The run it belongs to: the members in line through their
        /// joints, in order (itself among them).
        run: list<run-piece>,
        /// The run's length, m.
        length: f64,
        /// The bracing points along the run, by `at`.
        points: list<bracing-point>,
    }

    /// Checks the members of `input` by method `method` as
    /// `member-check-full`'s `check-members-full`, with `bracing` (one per
    /// member of `input` that has a run; a member without one: its lengths
    /// as before).
    check-members-bracing: func(method: string, input: full-input, bracing: list<member-bracing>) -> result<full-output, string>;
}

/// The `member-check-bracing` export with the `member-check-full` one
/// whose records it takes: how the host finds them in any plugin (not a
/// world to build plugins for).
world member-check-bracing-export {
    export member-check-full;
    export member-check-bracing;
}

/// A plugin giving a design code for structures (2026-11-18): its members
/// by `member-check` and `member-check-full`, its joints by
/// `joint-check` and (with its parameters) `joint-check-full`, the bolt
/// tools' minimum distances by `bolt-distances` (and, with the bolts'
/// data and its parameters, `bolt-distances-full`: third round), its
/// members' buckling lengths from what braces them by
/// `member-check-bracing` (2026-11-19), its joints' bolt groups under the
/// members' forces together by `joint-check-groups` (2026-11-19) and their
/// bolts in tension, with prying, by `joint-check-groups-tension`
/// (2026-11-19), the plates' prying too by `joint-check-groups-prying`
/// (2026-11-19), a bent plate's bend by `joint-check-bends` (2026-11-19).
world structure-code-plugin {
    include member-check-plugin;
    export member-check-full;
    export member-check-bracing;
    export joint-check;
    export joint-check-full;
    export joint-check-moments;
    export joint-check-groups;
    export joint-check-groups-tension;
    export joint-check-groups-prying;
    export joint-check-bends;
    export bolt-distances;
    export bolt-distances-full;
}
