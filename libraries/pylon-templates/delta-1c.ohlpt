# Pylon template: the face of the pylon (across and up, m), from which
# OpenOHL builds a structure type of level 1 for suspension or strain.
# Slots: a phase's set on a suspension type; strain types add 20 (back)
# and 40 (ahead). Synthetic dimensions: change them in the builder.
format = "ohl-pylon-template"
version = 1
id = "delta-1c"
name = "Delta, one circuit, one earth wire"
description = "Two phases on the lower crossarm, one on the upper; an earth wire at the peak."
kind = "lattice"
height = "peak"

[strings]
suspension_length = "3 m"
suspension_weight = "1 kN"
strain_length = "4 m"
strain_weight = "1.5 kN"

[[parameter]]
name = "lower_level"
default = "22 m"
description = "height of the lower crossarm"

[[parameter]]
name = "lower_half"
default = "5 m"
description = "lower crossarm: mast to each phase"

[[parameter]]
name = "upper_level"
default = "28 m"
description = "height of the upper crossarm"

[[parameter]]
name = "upper_across"
default = "4 m"
description = "upper crossarm: mast to the phase, to the right (negative: left)"

[[parameter]]
name = "peak"
default = "34 m"
description = "height of the peak (earth wire)"

[[attachment]]
slot = 1
label = "L1"
across = "-lower_half"
up = "lower_level"

[[attachment]]
slot = 2
label = "L2"
across = "upper_across"
up = "upper_level"

[[attachment]]
slot = 3
label = "L3"
across = "lower_half"
up = "lower_level"

[[earth]]
slot = 19
label = "E1"
across = "0"
up = "peak"
