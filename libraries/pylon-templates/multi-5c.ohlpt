# Pylon template (see delta-1c.ohlpt for the conventions).
# A crowded pylon: a two-phase circuit of four conductors on the top
# crossarm (slots 10-13), two three-phase circuits on the middle crossarm
# (left 1-3, right 4-6) and two on the bottom one (left 7-9, right
# 16-18); an earth wire at the peak (19).
format = "ohl-pylon-template"
version = 1
id = "multi-5c"
name = "Five circuits on three crossarms, one earth wire"
description = "Top: a two-phase circuit (four conductors); middle and bottom: a three-phase circuit on each side; an earth wire at the peak."
kind = "lattice"
height = "peak"

[strings]
suspension_length = "4.5 m"
suspension_weight = "1.5 kN"
strain_length = "5.5 m"
strain_weight = "2 kN"

[[parameter]]
name = "top_level"
default = "62 m"
description = "height of the top crossarm"

[[parameter]]
name = "top_inner"
default = "4 m"
description = "top crossarm: mast to the inner conductors"

[[parameter]]
name = "top_outer"
default = "8.5 m"
description = "top crossarm: mast to the outer conductors"

[[parameter]]
name = "middle_level"
default = "52 m"
description = "height of the middle crossarm"

[[parameter]]
name = "bottom_level"
default = "42 m"
description = "height of the bottom crossarm"

[[parameter]]
name = "step"
default = "4.5 m"
description = "middle and bottom crossarms: between the phases of a circuit"

[[parameter]]
name = "inner"
default = "4.5 m"
description = "middle and bottom crossarms: mast to the inner phase"

[[parameter]]
name = "peak"
default = "72 m"
description = "height of the peak (earth wire)"

[[attachment]]
slot = 10
label = "R-1"
across = "-top_outer"
up = "top_level"

[[attachment]]
slot = 11
label = "R-2"
across = "-top_inner"
up = "top_level"

[[attachment]]
slot = 12
label = "R-3"
across = "top_inner"
up = "top_level"

[[attachment]]
slot = 13
label = "R-4"
across = "top_outer"
up = "top_level"

[[attachment]]
slot = 1
label = "C1-L1"
across = "-inner"
up = "middle_level"

[[attachment]]
slot = 2
label = "C1-L2"
across = "-(inner + step)"
up = "middle_level"

[[attachment]]
slot = 3
label = "C1-L3"
across = "-(inner + 2 * step)"
up = "middle_level"

[[attachment]]
slot = 4
label = "C2-L1"
across = "inner"
up = "middle_level"

[[attachment]]
slot = 5
label = "C2-L2"
across = "inner + step"
up = "middle_level"

[[attachment]]
slot = 6
label = "C2-L3"
across = "inner + 2 * step"
up = "middle_level"

[[attachment]]
slot = 7
label = "C3-L1"
across = "-inner"
up = "bottom_level"

[[attachment]]
slot = 8
label = "C3-L2"
across = "-(inner + step)"
up = "bottom_level"

[[attachment]]
slot = 9
label = "C3-L3"
across = "-(inner + 2 * step)"
up = "bottom_level"

[[attachment]]
slot = 16
label = "C4-L1"
across = "inner"
up = "bottom_level"

[[attachment]]
slot = 17
label = "C4-L2"
across = "inner + step"
up = "bottom_level"

[[attachment]]
slot = 18
label = "C4-L3"
across = "inner + 2 * step"
up = "bottom_level"

[[earth]]
slot = 19
label = "E1"
across = "0"
up = "peak"
