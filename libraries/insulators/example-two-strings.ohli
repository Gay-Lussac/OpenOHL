# OpenOHL insulator assembly (.ohli): an EXAMPLE to start from.
# Typical values for two 220 kV composite strings to one clamp, not
# manufacturer data:
# check every value against the data sheet of the assembly you use.
format = "ohl-insulator"
version = 3
id = "example-220-v"
name = "Example 220 kV two suspension strings (typical values)"
kind = "suspension"
legs = 2
source = "OpenOHL example, typical values"
length = "3.0 m"
half_width = "1.6 m"
weight = "700 N"
axial_stiffness = "5e7 N"
wind_area = "0.4 m²"
